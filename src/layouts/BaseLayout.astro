---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../data/site';
import Topbar from '../components/Topbar.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  title: string;
  description?: string;
  /** Ruta canónica relativa, ej: "/nosotros/" */
  path?: string;
  /** JSON-LD adicional específico de la página */
  jsonLdExtra?: object | object[];
  /** Imagen OpenGraph personalizada */
  ogImage?: string;
  /** Tagline opcional para el Topbar */
  topbarTagline?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  /** Evitar indexación en motores de búsqueda (ej: 404) */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  path = '/',
  jsonLdExtra,
  ogImage = '/assets/og-jsan.jpg',
  topbarTagline,
  hideHeader = false,
  hideFooter = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const logoUrl = new URL('/assets/logo-jsan.webp', SITE.url).href;
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Hidrom%C3%A1ticos+J-SAN+C.A.+Monte+Cristo+Miranda+Caracas+Venezuela';

const jsonLdLocal: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${SITE.url}/#negocio`,
  name: SITE.name,
  legalName: SITE.name,
  alternateName: ['Hidromáticos J-SAN', 'Taller J-SAN', 'JSAN Cajas Automáticas'],
  url: SITE.url,
  logo: logoUrl,
  image: [ogImageUrl, logoUrl],
  telephone: [`+${SITE.whatsapp}`],
  email: SITE.email,
  foundingDate: String(SITE.fundacion),
  taxID: SITE.rif,
  priceRange: '$$',
  currenciesAccepted: 'USD, VED',
  paymentAccepted: 'Efectivo, Tarjeta de Débito, Tarjeta de Crédito, Pago Móvil, Zelle, Transferencia Bancaria',
  hasMap: mapsUrl,
  slogan: 'Líderes en Transmisiones Automáticas y Motores',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.sede,
    addressLocality: 'Caracas',
    addressRegion: 'Miranda',
    postalCode: '1071',
    addressCountry: 'VE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 10.4965,
    longitude: -66.8378,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.6',
    reviewCount: '35',
    bestRating: '5',
    worstRating: '1',
  },
  areaServed: ['Caracas', 'Miranda', 'Los Teques', 'Guarenas', 'Guatire', 'Venezuela'],
  sameAs: Object.values(SITE.redes),
};

const jsonLdWebsite: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#sitio`,
  url: SITE.url,
  name: SITE.shortName,
  alternateName: ['Hidromáticos JSAN', 'JSAN Cajas Automáticas Caracas'],
  inLanguage: 'es-VE',
  publisher: {
    '@id': `${SITE.url}/#negocio`,
  },
};

// Generación automática de BreadcrumbList para Google Rich Results
let jsonLdBreadcrumbs: Record<string, unknown> | null = null;
if (path !== '/' && !path.includes('404')) {
  const segments = path.split('/').filter(Boolean);
  const itemListElement = [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: `${SITE.url}/`,
    },
  ];

  let accumulated = SITE.url;
  segments.forEach((seg, idx) => {
    accumulated += `/${seg}/`;
    let segName = seg.replace(/-/g, ' ');
    if (seg === 'blog') segName = 'Blog';
    else if (seg === 'nosotros') segName = 'Nosotros';
    else if (seg === 'contacto') segName = 'Contacto';
    else if (seg === 'resenas') segName = 'Reseñas';
    else if (seg === 'videos') segName = 'Videos';
    else if (seg === 'terminos') segName = 'Términos y Condiciones';
    else segName = title.split('|')[0].split('·')[0].trim();

    itemListElement.push({
      '@type': 'ListItem',
      position: idx + 2,
      name: segName,
      item: accumulated,
    });
  });

  jsonLdBreadcrumbs = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement,
  };
}

const scriptsJsonLd = [
  jsonLdLocal,
  jsonLdWebsite,
  ...(jsonLdBreadcrumbs ? [jsonLdBreadcrumbs] : []),
  ...(jsonLdExtra ? (Array.isArray(jsonLdExtra) ? jsonLdExtra : [jsonLdExtra]) : []),
];
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#0f2a57" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Geotags para posicionamiento local en Google Maps y SEO local -->
    <meta name="geo.region" content="VE-M" />
    <meta name="geo.placename" content="Caracas, Miranda, Venezuela" />
    <meta name="geo.position" content="10.4965;-66.8378" />
    <meta name="ICBM" content="10.4965, -66.8378" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hidromáticos J-SAN · Especialistas en Cajas Automáticas en Caracas" />
    <meta property="og:locale" content="es_VE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Datos estructurados JSON-LD -->
    {scriptsJsonLd.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
  </head>
  <body>
    {!hideHeader && (
      <>
        <Topbar tagline={topbarTagline} />
        <Header activePath={path} />
      </>
    )}

    <slot />

    {!hideFooter && <SiteFooter />}

    <WhatsAppFloat />
  </body>
</html>
