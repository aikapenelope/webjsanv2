---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/Topbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE, waLink } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} | Hidromáticos J-SAN`;
const description = post.data.description;
const path = `/blog/${post.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString().split('T')[0],
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
};

const fmtDate = post.data.pubDate.toLocaleDateString('es-VE', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description} path={path} jsonLdExtra={jsonLd}>
  <Topbar tagline="Blog · Guías J-SAN" />
  <article style="max-width:52rem;padding:clamp(2rem,5vh,3.4rem) clamp(1.2rem,3vw,2.6rem)">
    <div class="kick">
      <span class="sq"></span>
      <span>{post.data.kicker} · {fmtDate}</span>
    </div>
    <h1 style="font-size:clamp(2.2rem,5vw,3.6rem)">{post.data.title}</h1>
    <div class="demo-note" style="margin-top:1.2rem;margin-bottom:1.8rem">
      <p>{post.data.description}</p>
    </div>

    <div class="blog-content">
      <Content />
    </div>

    <div class="opinion" style="margin-top:2.4rem">
      <div>
        <b>¿Tu carro presenta alguna de estas señales?</b>
        <p>Manda un mensaje o video del síntoma por WhatsApp y te decimos por dónde empezar — sin compromiso.</p>
      </div>
      <a
        class="cta-a"
        target="_blank"
        rel="noopener"
        href={waLink(`Hola J-SAN, leí su artículo sobre "${post.data.title}". Quiero consultar por mi carro`)}
      >
        Consultar mi caso →
      </a>
    </div>
  </article>
  <SiteFooter />
</BaseLayout>

<style>
  .blog-content :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.45rem;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin: 2rem 0 .6rem;
    color: var(--white);
  }
  .blog-content :global(p) {
    color: var(--grey);
    font-size: .95rem;
    line-height: 1.65;
    margin-bottom: 1.2rem;
  }
  .blog-content :global(strong) {
    color: var(--white);
  }
</style>
