---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';

const title = 'Nosotros · Hidromáticos J-SAN — Taller familiar de transmisiones desde 2013';
const description =
  'Propósito, misión, visión y valores del taller familiar especialista en transmisiones automáticas. Desde 2013 en Miranda, Venezuela.';

const VALORES = [
  { ico: 'estrella', t: 'Atención de calidad', s: 'Del hola a la entrega' },
  { ico: 'brujula', t: 'Asesoría completa', s: 'Antes de gastar un dólar' },
  { ico: 'escudo', t: 'Seriedad absoluta', s: 'Lo que prometemos, cumplimos' },
  { ico: 'reloj', t: 'Puntualidad', s: 'Tu tiempo vale como tu carro' },
  { ico: 'llave', t: 'Mano de obra excelente', s: 'Especialistas, no improvisados' },
];
---

<BaseLayout title={title} description={description} path="/nosotros/">
  <Topbar tagline="Taller Familiar · Est. 2013" />

  <div class="page-title">
    <div class="kick"><span class="sq"></span><span>Familia, no franquicia</span></div>
    <h1>Una familia que <em>entiende transmisiones</em></h1>
    <p class="demo-note" style="margin-top:1rem">
      Desde 2013 mantenemos en movimiento a Caracas y Miranda. Esta es la razón por la que existimos y hacia dónde vamos.
    </p>
  </div>

  <div class="pmv-full">
    <div class="pmv-b">
      <div class="pn"><i>N° 01</i><h2>Propósito</h2></div>
      <div>
        <p class="pf">Mantener en movimiento a las familias y empresas venezolanas con total seguridad y confianza.</p>
        <p class="pt">
          En J-SAN creemos que un vehículo es más que un medio de transporte; es una herramienta de trabajo y un conector de
          familias. Nuestro propósito es garantizar la tranquilidad de cada cliente al volante, ofreciendo soluciones mecánicas
          honestas y definitivas, respaldadas por nuestros valores familiares.
        </p>
      </div>
    </div>
    <div class="pmv-b" style="background:var(--panel)">
      <div class="pn"><i>N° 02</i><h2>Misión</h2></div>
      <div>
        <p class="pf">Brindar soluciones especializadas de máxima calidad en el diagnóstico, mantenimiento y reparación de transmisiones automáticas.</p>
        <p class="pt">
          Desde 2013, combinamos nuestra profunda experiencia técnica en hidromáticos con la dedicación de una empresa familiar.
          Nos comprometemos a ofrecer a cada cliente un trato transparente, diagnósticos precisos y un servicio de excelencia que
          asegure el rendimiento óptimo y la vida útil de sus vehículos.
        </p>
      </div>
    </div>
    <div class="pmv-b">
      <div class="pn"><i>N° 03</i><h2>Visión</h2></div>
      <div>
        <p class="pf">Consolidarnos como el taller mecánico de referencia indiscutible en Venezuela en el área de hidromáticos.</p>
        <p class="pt">
          Aspiramos a liderar el sector automotriz manteniendo la esencia de nuestros orígenes familiares, siendo reconocidos por
          nuestra constante actualización técnica, la calidad impecable de nuestras reparaciones y la confianza inquebrantable de
          múltiples generaciones de clientes.
        </p>
      </div>
    </div>
  </div>

  <section style="padding-block:clamp(2.6rem,6vh,4rem)">
    <div class="kick"><span class="sq"></span><span>Lo que nos sostiene</span></div>
    <h2 style="font-family:var(--font-display);font-weight:400;font-size:clamp(1.9rem,4vw,3rem);text-transform:uppercase;margin-bottom:1.8rem">
      Valores familiares,<br />estándares profesionales
    </h2>
    <div class="valores-grid">
      {VALORES.map((v) => (
        <div class="vg">
          <b>{v.t}</b>
          <span>{v.s}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="final" id="contacto" style="padding-top:clamp(2.6rem,6vh,4rem);padding-bottom:clamp(2.6rem,6vh,4rem)">
    <div class="kick"><span class="sq"></span><span>Contacto</span></div>
    <h2>¿Tu caja está patinando?</h2>
    <span class="f-phone">0424 <em>232.0424</em></span>
    <div class="f-btns">
      <a class="fb-dark" target="_blank" rel="noopener" href={`https://wa.me/${SITE.whatsapp}`}>Escribir por WhatsApp</a>
      <a class="fb-outline" href="/contacto/">Ver todos los canales →</a>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>
