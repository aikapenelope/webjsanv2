---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, waLink } from '../data/site';

const title = 'Contacto · Hidromáticos J-SAN — WhatsApp, teléfonos y sede en Miranda';
const description =
  'Escríbenos por WhatsApp, llámanos o visítanos en nuestra sede de Monte Cristo, Miranda. Atendemos lunes a sábado con cita previa.';

const WA_FALLA = waLink('Hola J-SAN, quiero consultar por una falla en mi caja automática');
const WA_AGENDAR = waLink('Hola J-SAN, quiero agendar un escaneo para mi carro');
---

<BaseLayout title={title} description={description} path="/contacto/">
  <Topbar tagline="Contacto · Est. 2013" />

  <div class="page-title">
    <div class="kick"><span class="sq"></span><span>Estamos para servirte</span></div>
    <h1>Hablemos de <em>tu carro</em></h1>
    <p class="demo-note" style="margin-top:1rem">
      Escríbenos por WhatsApp con el modelo y año de tu carro y te respondemos con el primer paso.
    </p>
  </div>

  <div class="c-grid" style="margin-top:1.8rem">
    <div class="c-cell">
      <i>CANAL 01 — MÁS RÁPIDO</i>
      <h3>WhatsApp directo</h3>
      <p>Manda una foto o un video del síntoma. Respondemos en horario de trabajo.</p>
      <a class="grande" target="_blank" rel="noopener" href={WA_FALLA}>{SITE.whatsappDisplay} ↗</a>
    </div>
    <div class="c-cell">
      <i>CANAL 02</i>
      <h3>Teléfonos fijos</h3>
      <p>Oficina y taller, en horario continuo.</p>
      <a class="grande" href={`tel:${SITE.phoneOficina1}`}>{SITE.phoneOficina1Display}</a>
      <a class="grande" href={`tel:${SITE.phoneOficina2}`}>{SITE.phoneOficina2Display}</a>
    </div>
    <div class="c-cell">
      <i>CANAL 03</i>
      <h3>Correo</h3>
      <p>Para cotizaciones formales y flotas de empresas.</p>
      <a class="grande" style="font-size:clamp(1.1rem,2.4vw,1.7rem)" href={`mailto:${SITE.email}`}>{SITE.email} ↗</a>
    </div>
    <div class="c-cell">
      <i>HORARIO</i>
      <h3>Lunes a sábado</h3>
      <p>Atendemos con cita previa agendada por WhatsApp para evitar esperas.</p>
      <a class="grande" target="_blank" rel="noopener" style="font-size:clamp(1.1rem,2.4vw,1.7rem)" href={WA_AGENDAR}>
        AGENDAR ESCANEO →
      </a>
    </div>
  </div>

  <div class="mapa-fake">
    <div>
      <b>Nuestra sede — Monte Cristo</b>
      <p>
        <strong style="color:var(--orange)">SEDE:</strong> {SITE.sede}.<br /><br />
        {SITE.horario}.
      </p>
      <a
        class="btn-o"
        style="display:inline-flex;margin-top:0"
        target="_blank"
        rel="noopener"
        href="https://www.google.com/maps/search/?api=1&query=Hidrom%C3%A1ticos+J-SAN+C.A.+Monte+Cristo+Miranda+Caracas+Venezuela"
      >
        ABRIR EN GOOGLE MAPS →
      </a>
    </div>
  </div>

  <SiteFooter />
</BaseLayout>
