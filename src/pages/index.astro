---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, MARCAS, waLink } from '../data/site';

const WA_FALLA = waLink('Hola J-SAN, quiero consultar por una falla en mi caja automática');
const WA_AGENDAR = waLink('Hola J-SAN, quiero agendar un escaneo para mi carro');

const SERVICIOS = [
  {
    num: '01',
    titulo: 'Diagnóstico & Electrónica',
    items: [
      'Escaneo computarizado y lectura de códigos DTC',
      'Prueba de manejo diagnóstica con el especialista',
      'Reparación de TCM y módulos de transmisión',
      'Chequeo de cableados y sensores',
    ],
  },
  {
    num: '02',
    titulo: 'Reparación & Reconstrucción',
    items: [
      'Reparación de cajas automáticas de todas las marcas',
      'Reconstrucción completa con kit master',
      'Cuerpo de válvulas y solenoides',
      'Convertidor de par: reparación y balanceo',
      'Piezas duras: tambos, planetarios, bombas',
    ],
  },
  {
    num: '03',
    titulo: 'Mantenimiento & Cambios',
    items: [
      'Servicio de aceite y filtro ATF',
      'Cambio completo de caja: usada, recondicionada o nueva',
      'Servicio especializado en motores',
      'Mecánica automotriz en general',
    ],
  },
  {
    num: '04',
    titulo: 'Repuestos & Importación',
    items: [
      'Discos, bandas y solenoides originales y alternativos',
      'Importación directa de motores y cajas',
      'Búsqueda de piezas difíciles bajo pedido',
      'Garantía escrita y post-venta',
    ],
  },
];

const PROCESO = [
  { n: '1', t: 'Traes el carro', p: 'Nos cuentas qué sentiste: patineo, golpe o luz encendida. Lo anotamos todo.' },
  { n: '2', t: 'Escaneamos', p: 'Scanner + revisión del especialista. Sabrás qué falla de verdad.' },
  { n: '3', t: 'Apruebas', p: 'Cotización clara por WhatsApp. Nada se toca sin tu visto bueno.' },
  { n: '4', t: 'Entregamos', p: 'Reparación con repuestos importados y carro listo para la calle.' },
];

const RESENAS = [
  {
    iniciales: 'LS',
    nombre: 'Lisbeth Sierra',
    meta: '“Rápidos y confiables”',
    texto:
      'Llevé mi camioneta con un sonido extraño, y muy rápido detectaron qué lo causaba y se pudo solucionar. Les recomiendo ampliamente.',
  },
  {
    iniciales: 'CR',
    nombre: 'Carlos Rodríguez',
    meta: 'Chevrolet Aveo · Reparación de caja',
    texto:
      'Me reconstruyeron la caja del Aveo y quedó como nueva. Presupuesto claro desde el primer día y cumplieron con el tiempo dicho.',
  },
  {
    iniciales: 'MF',
    nombre: 'María Fernández',
    meta: 'Ford Explorer · Servicio ATF',
    texto:
      'Le hicieron el servicio completo a la Explorer de la empresa y el trato fue de primera, muy serios con el trabajo.',
  },
];

const MQ =
  'Especialista en cajas automáticas ◆ Importadores de motores y repuestos ◆ Escaneo computarizado ◆ Presupuesto antes de trabajar ◆ Servicio ATF ◆ Convertidor de par ◆ ';

// Logos de marcas como SVG crudo embebido en build (mantiene currentColor para el hover)
const iconos = import.meta.glob('../assets/marcas/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const icono = (slug: string) =>
  iconos[`../assets/marcas/${slug}.svg`] ?? '';
---

<BaseLayout
  title="Hidromáticos J-SAN · Especialistas en Cajas Automáticas — Caracas"
  path="/"
>
  <div class="shell">
    <Sidebar />

    <main class="main">
      <!-- HERO -->
      <div class="hero">
        <div class="hero-top">
          <a class="tb-mob" href="/" aria-label="Inicio J-SAN" style="display:none;align-items:center;gap:.55rem">
            <img src="/assets/logo-jsan.webp" alt="Escudo J-SAN" style="width:40px;height:auto" /><b style="font-family:var(--font-display);font-weight:400;font-size:1rem;letter-spacing:.05em">J-SAN</b>
          </a>
          <span class="tag">Caracas · Miranda · Venezuela</span>
          <button class="burger" id="burger" aria-label="Abrir menú"><span></span></button>
          <span class="tel">0424 <em>·</em> 232.0424</span>
        </div>

        <div class="hero-mid">
          <div class="h-num"><span class="sq"></span><span>Taller especializado · Est. 2013</span></div>
          <h1>Cajas automáticas<br /><span class="stroke">sin miedo</span><br />a que te <span class="solid-o">vean</span></h1>
          <p class="hero-sub">
            Diagnóstico con scanner antes de abrir tu caja. Presupuesto claro por WhatsApp y repuestos importados cuando la reparación lo exige.
          </p>
          <div class="hero-ctas">
            <a class="cta-a" target="_blank" rel="noopener" href={WA_FALLA}>Consultar mi falla →</a>
            <a class="cta-b" href="#servicios">Ver servicios</a>
          </div>
        </div>

        <img
          class="hero-escudo"
          src="/assets/logo-jsan.webp"
          alt="Escudo de Hidromáticos J-SAN, C.A."
          width="230"
          height="213"
        />

        <div class="mq" aria-hidden="true">
          <div class="mq-track">
            <span>{MQ}&nbsp;</span>
            <span>{MQ}&nbsp;</span>
          </div>
        </div>
      </div>

      <!-- STATS -->
      <div class="stats">
        <div class="stat"><b>12<em>+</em></b><span>Años de experiencia</span></div>
        <div class="stat"><b>16</b><span>Marcas que atendemos</span></div>
        <div class="stat"><b>5<em>★</em></b><span>Calificación en Google</span></div>
        <div class="stat"><b>100<em>%</em></b><span>Presupuesto aprobado antes de trabajar</span></div>
      </div>

      <!-- SERVICIOS -->
      <section id="servicios">
        <div class="sec-head">
          <div>
            <div class="kick"><span class="sq"></span><span>Lo que hacemos</span></div>
            <h2>Todo para tu <em>transmisión</em>, un solo taller</h2>
          </div>
          <p>Abre cada línea: así trabajamos. Sin tecnicismos innecesarios y sin cobros sorpresa.</p>
        </div>
        <div class="acc">
          {SERVICIOS.map((s, i) => (
            <details open={i === 0}>
              <summary>
                <span class="a-num">{s.num}</span>
                <span class="a-title">{s.titulo}</span>
                <span class="a-plus">+</span>
              </summary>
              <ul class="a-body">
                {s.items.map((it) => <li>{it}</li>)}
              </ul>
            </details>
          ))}
        </div>
      </section>

      <!-- PROCESO -->
      <section class="proc" id="proceso">
        <div class="sec-head">
          <div>
            <div class="kick"><span class="sq"></span><span>Cómo trabajamos</span></div>
            <h2>Cuatro pasos, <em>cero sorpresas</em></h2>
          </div>
        </div>
        <div class="p-steps">
          {PROCESO.map((p) => (
            <div class="p-step"><i>{p.n}</i><h3>{p.t}</h3><p>{p.p}</p></div>
          ))}
        </div>
      </section>

      <!-- MARCAS -->
      <section id="marcas">
        <div class="sec-head">
          <div>
            <div class="kick"><span class="sq"></span><span>Todas las marcas</span></div>
            <h2>Si trae caja automática, <em>lo atendemos</em></h2>
          </div>
        </div>
        <div class="brand-tiles">
          {MARCAS.map((slug) => (
            <div class="bt">
              <span class="bt-ico" set:html={icono(slug)} />
              <span>{slug === 'volkswagen' ? 'VW' : slug.charAt(0).toUpperCase() + slug.slice(1)}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- CLIENTES / RESEÑAS -->
      <section id="clientes">
        <div class="sec-head">
          <div>
            <div class="kick"><span class="sq"></span><span>Lo que dicen</span></div>
            <h2>Clientes que <em>vuelven</em></h2>
          </div>
        </div>
        <div class="t-grid">
          {RESENAS.map((r) => (
            <article class="t-card">
              <span class="t-stars">★★★★★</span>
              <p>{r.texto}</p>
              <div class="t-by">
                <span class="sqv">{r.iniciales}</span>
                <div><b>{r.nombre}</b><span>{r.meta}</span></div>
              </div>
            </article>
          ))}
        </div>
        <div class="opinion">
          <div>
            <b>Valoramos tu opinión</b>
            <p>Tu recomendación ayuda a otro venezolano a encontrar un taller de confianza. Cuéntanos cómo fue tu experiencia.</p>
          </div>
          <a class="cta-b" style="border-color:var(--orange-deep)" href="/resenas/">★ Déjanos tu opinión</a>
        </div>
      </section>

      <!-- NOSOTROS -->
      <section class="nos-teaser" id="nosotros">
        <div class="sec-head">
          <div>
            <div class="kick"><span class="sq"></span><span>Familia, no franquicia</span></div>
            <h2>Una familia que entiende transmisiones</h2>
          </div>
        </div>
        <div class="pmv">
          <article>
            <i>N° 01</i><h3>Propósito</h3>
            <p>Mantener en movimiento a las familias y empresas venezolanas con seguridad y confianza.</p>
          </article>
          <article>
            <i>N° 02</i><h3>Misión</h3>
            <p>Soluciones especializadas de máxima calidad en diagnóstico, mantenimiento y reparación de transmisiones automáticas.</p>
          </article>
          <article>
            <i>N° 03</i><h3>Visión</h3>
            <p>Ser el taller de referencia indiscutible en Venezuela en el área de hidromáticos.</p>
          </article>
        </div>
        <div style="margin-top:1.6rem">
          <a class="btn-line" style="display:inline-flex;margin-top:0" href="/nosotros/">Conoce la historia completa →</a>
        </div>
      </section>

      <!-- CONTACTO / FINAL -->
      <section class="final" id="contacto">
        <div class="kick"><span class="sq"></span><span>Contacto</span></div>
        <h2>¿Tu caja está patinando?</h2>
        <span class="f-phone">0424 <em>232.0424</em></span>
        <p class="f-note">
          Sede: Urb. Monte Cristo, 1ra con 3ra transversal, Calle 10, Miranda · Caracas. Lun–Sáb, previa cita por WhatsApp.
        </p>
        <div class="f-btns">
          <a class="fb-dark" target="_blank" rel="noopener" href={WA_AGENDAR}>Agendar escaneo</a>
          <a class="fb-outline" href={`mailto:${SITE.email}`}>Escribir correo</a>
        </div>
      </section>

      <SiteFooter />
    </main>
  </div>
</BaseLayout>

<style>
  /* logo móvil visible solo <=1020px (la sidebar desaparece), sobre plinto metálico */
  .tb-mob{display:none!important}
  .tb-mob img{background:var(--panel-2);border:2px solid var(--line-strong);padding:.35rem}
  @media (max-width:1020px){
    .tb-mob{display:flex!important}
  }
</style>
