---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServicesSection from '../components/ServicesSection.astro';
import SymptomSelector from '../components/SymptomSelector.astro';
import ProcessCards from '../components/ProcessCards.astro';
import BrandsMarquee from '../components/BrandsMarquee.astro';
import MarcasUsa from '../components/MarcasUsa.astro';
import TallerGallery from '../components/TallerGallery.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import LocationsSection from '../components/LocationsSection.astro';
import FaqAccordion, { FAQS } from '../components/FaqAccordion.astro';
import FinalCta from '../components/FinalCta.astro';
import { SITE } from '../data/site';

const title = `${SITE.name} · Especialistas en Cajas Automáticas — Caracas`;
const description =
  'Reparación y reconstrucción de cajas automáticas y motores en Caracas. Escaneo computarizado, repuestos importados y garantía escrita. Desde 2013 en Miranda, Venezuela.';

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonLdExtra={jsonLdFaq}
>
  <main>
    <!-- HERO SECTION CON ESCUDO & BADGE FLOTANTE -->
    <Hero />

    <!-- FRANJA DE CONFIANZA ANIMADA CON MOVIMIENTO CONTINUO -->
    <TrustStrip />

    <!-- SERVICIOS ESPECIALIZADOS DE DIAGNÓSTICO Y RECONSTRUCCIÓN -->
    <ServicesSection />

    <!-- SELECTOR INTERACTIVO DE SÍNTOMAS & DIAGNÓSTICO GUIADO -->
    <SymptomSelector />

    <!-- PROCESO DE TALLER EN 4 PASOS TRANSPARENTES -->
    <ProcessCards />

    <!-- MARQUESINA INFINITA DE 16 MARCAS AUTOMOTRICES -->
    <BrandsMarquee />

    <!-- REPUESTOS IMPORTADOS USA (SONNAX, TRANSGO, TRANSTEC) -->
    <MarcasUsa />

    <!-- CASOS REALES EN TALLER & CONTENIDO DE REDES -->
    <TallerGallery />

    <!-- TESTIMONIOS & CARRUSEL DE RESEÑAS GOOGLE ★4.6 -->
    <ReviewsSection />

    <!-- SEDE MONTE CRISTO (CARACAS) CON MAPA INTERACTIVO -->
    <LocationsSection />

    <!-- PREGUNTAS FRECUENTES ACCESIBLES -->
    <FaqAccordion />

    <!-- CTA FINAL DE CONVERSIÓN -->
    <FinalCta />
  </main>
</BaseLayout>
