---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const title = `${SITE.shortName} · Especialistas en Cajas Automáticas — Caracas`;
---

<BaseLayout title={title} path="/">
  <main class="wrap" style="padding: 4rem 0;">
    <span class="eyebrow">★ Caracas · Miranda · Desde 2013</span>
    <h1 style="font-family: var(--font-display); font-size: clamp(2.4rem, 5vw, 4.2rem); text-transform: uppercase; line-height: 1;">
      Tu caja automática en manos de <span style="color: var(--blue);">líderes</span>
    </h1>
    <p style="color: var(--muted); margin-top: 1rem; max-width: 36rem; font-size: 1.1rem;">
      Reparación de cajas automáticas y motores en Caracas. Escaneo computarizado, presupuesto claro antes de trabajar y repuestos importados.
    </p>
    <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href={`https://wa.me/${SITE.whatsapp}`} class="btn btn-primary" target="_blank" rel="noopener">
        Consultar falla por WhatsApp
      </a>
      <a href="#servicios" class="btn btn-ghost">
        Ver servicios
      </a>
    </div>
  </main>
</BaseLayout>
