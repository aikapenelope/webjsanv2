---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';

const title = 'Blog · Hidromáticos J-SAN — Guías de transmisiones automáticas';
const description =
  'Guías claras sobre cajas automáticas: por qué patina tu caja, qué es el servicio ATF, señales del convertidor de par y más. Por el equipo de Hidromáticos J-SAN, Caracas.';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const jsonLdBlog = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog de ${SITE.shortName}`,
  url: new URL('/blog/', SITE.url).href,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.pubDate.toISOString().split('T')[0],
    author: { '@type': 'Organization', name: SITE.name },
    url: new URL(`/blog/${p.id}/`, SITE.url).href,
  })),
};

const fmt = (d: Date) =>
  d.toLocaleDateString('es-VE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} path="/blog/" jsonLdExtra={jsonLdBlog}>
  <Topbar tagline="Conocimiento · Est. 2013" />

  <div class="page-title">
    <div class="kick"><span class="sq"></span><span>Aprende antes de gastar</span></div>
    <h1>Guías de <em>transmisiones</em>, sin tecnicismos</h1>
    <p class="demo-note" style="margin-top:1rem">
      Lo que 12 años arreglando cajas nos enseñó, explicado para dueños de carros — no para mecánicos.
    </p>
  </div>

  <div class="c-grid" style="margin-top:1.8rem">
    {posts.map((p) => (
      <article class="c-cell">
        <i>{p.data.kicker}</i>
        <h3>{p.data.title}</h3>
        <p>{p.data.description}</p>
        <p style="font-size:.76rem;color:var(--grey-dark);margin:.6rem 0 1rem">{fmt(p.data.pubDate)} · {p.data.readingTime} min de lectura</p>
        <a class="btn-o" style="display:inline-flex;margin-top:0;padding:.7rem 1.2rem;font-size:.78rem" href={`/blog/${p.id}/`}>
          LEER GUÍA →
        </a>
      </article>
    ))}
  </div>

  <SiteFooter />
</BaseLayout>
