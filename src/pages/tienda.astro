---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTOS } from '../data/productos';
import { SITE, waLink } from '../data/site';

const title = `Catálogo de Transmisiones & Cajas Automáticas · ${SITE.shortName} — Caracas`;
const description =
  'Compra o cotiza tu caja automática recondicionada, usada o nueva importada en HIDROMÁTICOS J.SAN. Toyota, Ford, Chevrolet, Hyundai, VW, BMW y más. Taller en Monte Cristo, Caracas.';

const waAsesoria = waLink('Hola J-SAN, estoy buscando una transmisión para mi carro y no la veo en el catálogo');

const jsonLdShop = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Catálogo de Transmisiones y Cajas Automáticas — HIDROMÁTICOS J.SAN, C.A.',
  itemListElement: PRODUCTOS.map((p, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: p.nombre,
      description: p.specs.join('. '),
      brand: { '@type': 'Brand', name: p.marca },
      image: new URL(p.imagen, SITE.url).href,
      offers: {
        '@type': 'Offer',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        itemCondition: p.estado === 'Nueva Importada' ? 'https://schema.org/NewCondition' : 'https://schema.org/RefurbishedCondition',
      },
    },
  })),
};
---

<BaseLayout title={title} description={description} path="/tienda/" jsonLdExtra={jsonLdShop} topbarTagline="Tienda & Catálogo de Transmisiones">
  <main class="shop-page">
    <!-- HERO TIENDA -->
    <section class="hero-shop">
      <div class="wrap">
        <span class="kicker">Disponibilidad en Caracas</span>
        <h1>Cajas automáticas &amp; <em>transmisiones listas para montar</em></h1>
        <p class="shop-lead">
          Unidades probadas en banco, con overhaul completo y garantía por escrito de 6 meses. Si no encuentras la de tu vehículo, la ubicamos o importamos bajo pedido.
        </p>

        <div class="shop-notice">
          <span class="notice-icon">ℹ️</span>
          <span>¿No ves el modelo exacto de tu carro? Traemos cajas bajo pedido de Estados Unidos y Asia en tiempo récord.</span>
        </div>
      </div>
    </section>

    <!-- BARRA DE FILTROS FLOTANTE / STICKY -->
    <div class="filtros-bar">
      <div class="wrap filtros-inner">
        <div class="filtros-group">
          <span class="filtros-label">Marca:</span>
          <div class="chips-list" id="filter-marcas">
            <button class="chip chip-marca on" data-filter="all">Todas</button>
            <button class="chip chip-marca" data-filter="toyota">Toyota</button>
            <button class="chip chip-marca" data-filter="ford">Ford</button>
            <button class="chip chip-marca" data-filter="chevrolet">Chevrolet</button>
            <button class="chip chip-marca" data-filter="hyundai">Hyundai / Kia</button>
            <button class="chip chip-marca" data-filter="volkswagen">VW / Audi</button>
            <button class="chip chip-marca" data-filter="mercedes">Mercedes</button>
            <button class="chip chip-marca" data-filter="bmw">BMW</button>
            <button class="chip chip-marca" data-filter="universal">Turbinas &amp; Repuestos</button>
          </div>
        </div>

        <div class="filtros-group">
          <span class="filtros-label">Condición:</span>
          <div class="chips-list" id="filter-estados">
            <button class="chip chip-estado on" data-estado="all">Todas</button>
            <button class="chip chip-estado" data-estado="recon">Recondicionadas</button>
            <button class="chip chip-estado" data-estado="nueva">Nuevas Importadas</button>
          </div>
        </div>

        <div class="contador-box">
          <span id="items-counter">{PRODUCTOS.length} productos disponibles</span>
        </div>
      </div>
    </div>

    <!-- GRID DE PRODUCTOS -->
    <section class="catalog-grid-sec">
      <div class="wrap">
        <div class="catalog-grid" id="catalog-grid">
          {PRODUCTOS.map((prod) => (
            <ProductCard producto={prod} />
          ))}
        </div>

        <div class="no-results" id="no-results" style="display: none;">
          <h3>No encontramos transmisiones con los filtros seleccionados</h3>
          <p>Podemos ubicar la caja o repuesto exacto que necesitas mediante importación directa.</p>
          <a class="btn btn-primary" href={waAsesoria} target="_blank" rel="noopener">
            Consultar por mi modelo específico por WhatsApp →
          </a>
        </div>
      </div>
    </section>

    <!-- CÓMO COMPRAR EN 4 PASOS -->
    <section class="como-comprar-sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="kicker kicker-light">Proceso transparente</span>
          <h2>Cómo adquirir tu transmisión en 4 pasos</h2>
          <p>Comodidad, seriedad y entrega garantizada en nuestro taller de Monte Cristo, Caracas.</p>
        </div>

        <div class="pasos-grid">
          <article class="paso-card">
            <i>PASO 01</i>
            <h3>Consulta de Compatibilidad</h3>
            <p>Envíanos una foto del serial de carrocería (VIN), chapa del motor o código de la caja para asegurar correspondencia 100% exacta.</p>
          </article>
          <article class="paso-card">
            <i>PASO 02</i>
            <h3>Cotización &amp; Disponibilidad</h3>
            <p>Te confirmamos precio, estado, tiempo de entrega y si requieres montaje con servicio en nuestro taller de Monte Cristo.</p>
          </article>
          <article class="paso-card">
            <i>PASO 03</i>
            <h3>Instalación o Retiro</h3>
            <p>Retiras en nuestras instalaciones en Caracas o agendas instalación y montaje con nuestros mecánicos especialistas.</p>
          </article>
          <article class="paso-card">
            <i>PASO 04</i>
            <h3>Garantía Escrita</h3>
            <p>Recibes tu certificado de garantía de 6 meses en transmisiones completas y respaldo técnico directo de nuestros especialistas.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- GARANTÍAS DE COMPRA -->
    <section class="garantias-sec">
      <div class="wrap">
        <div class="garantias-grid">
          <div class="g-card">
            <span class="g-ico">🛡️</span>
            <b>Garantía Escrita de 6 Meses</b>
            <p>Todas nuestras cajas completas recondicionadas cuentan con respaldo total en mano de obra y componentes internos.</p>
          </div>
          <div class="g-card">
            <span class="g-ico">⚙️</span>
            <b>Opción de Montaje &amp; Calibración</b>
            <p>Disponemos de fosas y elevadores en Caracas para entregar tu carro rodando y calibrado electrónicamente con scanner.</p>
          </div>
          <div class="g-card">
            <span class="g-ico">🏢</span>
            <b>Taller Físico en Monte Cristo</b>
            <p>Instalaciones establecidas desde 2013 en Caracas con resguardo seguro para tu vehículo.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .shop-page {
    background: #ffffff;
  }

  .hero-shop {
    background:
      radial-gradient(circle at 88% 10%, rgba(45, 88, 147, 0.09), transparent 45%),
      linear-gradient(180deg, #ffffff, var(--sky) 140%);
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--sky-line);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    line-height: 0.98;
    text-transform: uppercase;
    color: var(--navy);
  }

  h1 em {
    font-style: normal;
    color: var(--blue);
  }

  .shop-lead {
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.6;
    margin-top: 1rem;
    max-width: 44rem;
  }

  .shop-notice {
    margin-top: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #ffffff;
    border: 1.5px dashed var(--gold);
    border-radius: 12px;
    padding: 0.75rem 1.2rem;
    font-size: 0.9rem;
    color: var(--navy);
    box-shadow: 0 4px 14px rgba(15, 42, 87, 0.05);
  }

  /* BARRA DE FILTROS */
  .filtros-bar {
    position: sticky;
    top: 64px;
    z-index: 40;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--sky-line);
    padding: 0.85rem 0;
    box-shadow: 0 4px 16px rgba(15, 42, 87, 0.04);
  }

  .filtros-inner {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .filtros-group {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .filtros-label {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .chips-list {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .chip {
    border: 1.5px solid var(--sky-line);
    background: #ffffff;
    color: var(--navy);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: var(--font-body);
  }

  .chip:hover {
    border-color: var(--blue);
  }

  .chip.on {
    background: var(--navy);
    border-color: var(--navy);
    color: #ffffff;
  }

  .chip-estado.on {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--navy-deep);
  }

  .contador-box {
    margin-left: auto;
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }

  /* GRID */
  .catalog-grid-sec {
    padding: 3.4rem 0 4.8rem;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }

  .no-results {
    text-align: center;
    padding: 4rem 1rem;
    background: var(--sky);
    border: 1px dashed var(--sky-line);
    border-radius: var(--radius);
  }

  .no-results h3 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }

  .no-results p {
    color: var(--muted);
    margin-bottom: 1.6rem;
  }

  /* CÓMO COMPRAR */
  .como-comprar-sec {
    background: linear-gradient(180deg, var(--navy), var(--navy-deep));
    color: #ffffff;
    padding: 4.6rem 0;
    border-top: 3px solid var(--gold);
  }

  .sec-head {
    max-width: 48rem;
    margin-bottom: 2.8rem;
  }

  .kicker-light {
    color: var(--gold-soft);
  }

  .kicker-light::before {
    background: var(--gold);
  }

  .como-comprar-sec h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.4vw, 3.2rem);
    text-transform: uppercase;
    color: #ffffff;
  }

  .como-comprar-sec p {
    color: var(--muted-dark);
    margin-top: 0.6rem;
    font-size: 1.05rem;
  }

  .pasos-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .paso-card {
    background: var(--navy-panel);
    padding: 2rem 1.6rem;
  }

  .paso-card i {
    font-style: normal;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--gold-soft);
    letter-spacing: 0.14em;
    display: block;
    margin-bottom: 0.6rem;
  }

  .paso-card h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .paso-card p {
    font-size: 0.9rem;
    color: var(--muted-dark);
    line-height: 1.45;
  }

  /* GARANTÍAS */
  .garantias-sec {
    padding: 4rem 0;
    background: #ffffff;
    border-top: 1px solid var(--sky-line);
  }

  .garantias-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }

  .g-card {
    background: var(--sky);
    border: 1px solid var(--sky-line);
    border-top: 4px solid var(--gold);
    border-radius: var(--radius);
    padding: 2rem 1.8rem;
    box-shadow: 0 8px 22px rgba(15, 42, 87, 0.05);
  }

  .g-ico {
    font-size: 1.8rem;
    display: block;
    margin-bottom: 0.8rem;
  }

  .g-card b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    text-transform: uppercase;
    color: var(--navy);
    display: block;
    margin-bottom: 0.4rem;
  }

  .g-card p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  @media (max-width: 1040px) {
    .catalog-grid {
      grid-template-columns: 1fr 1fr;
    }
    .pasos-grid {
      grid-template-columns: 1fr 1fr;
    }
    .garantias-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .hero-shop {
      padding: 2.8rem 0 2.2rem;
    }
    .catalog-grid {
      grid-template-columns: 1fr;
    }
    .pasos-grid {
      grid-template-columns: 1fr;
    }
    .filtros-bar {
      top: 56px;
      padding: 0.6rem 0;
    }
    .contador-box {
      margin-left: 0;
      width: 100%;
    }
  }
</style>

<script>
  function setupFilters() {
    const marcaChips = document.querySelectorAll<HTMLButtonElement>('.chip-marca');
    const estadoChips = document.querySelectorAll<HTMLButtonElement>('.chip-estado');
    const cards = document.querySelectorAll<HTMLElement>('.prod-card');
    const counter = document.getElementById('items-counter');
    const noResults = document.getElementById('no-results');

    let activeMarca = 'all';
    let activeEstado = 'all';

    function filterProducts() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardMarca = card.getAttribute('data-marca') || '';
        const cardEstado = card.getAttribute('data-estado') || '';

        const matchMarca = activeMarca === 'all' || cardMarca === activeMarca;
        const matchEstado = activeEstado === 'all' || cardEstado === activeEstado;

        if (matchMarca && matchEstado) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (counter) {
        counter.textContent = `${visibleCount} producto${visibleCount === 1 ? '' : 's'} disponible${visibleCount === 1 ? '' : 's'}`;
      }

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    marcaChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        marcaChips.forEach((c) => c.classList.remove('on'));
        chip.classList.add('on');
        activeMarca = chip.getAttribute('data-filter') || 'all';
        filterProducts();
      });
    });

    estadoChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        estadoChips.forEach((c) => c.classList.remove('on'));
        chip.classList.add('on');
        activeEstado = chip.getAttribute('data-estado') || 'all';
        filterProducts();
      });
    });
  }

  setupFilters();
  document.addEventListener('astro:page-load', setupFilters);
</script>
