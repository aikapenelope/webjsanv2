---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import { RESENAS } from '../data/site';

const title = 'Reseñas · Hidromáticos J-SAN — ★ 4.6 con 35 opiniones en Google';
const description =
  'Lee las reseñas reales de clientes de Hidromáticos J-SAN en Google (★4.6, 35 opiniones) y déjanos la tuya: tu recomendación ayuda a otro venezolano a encontrar un taller de confianza.';

const LINK_MAPS =
  'https://www.google.com/maps/search/?api=1&query=Hidrom%C3%A1ticos+J-SAN+C.A.+Monte+Cristo+Miranda+Caracas+Venezuela';

const jsonLdResenas = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Servicio de transmisión automática — Hidromáticos J-SAN',
  brand: { '@type': 'Brand', name: 'Hidromáticos J-SAN' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.6', reviewCount: '35' },
  review: RESENAS.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.nombre },
    reviewBody: r.texto,
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
  })),
};
---

<BaseLayout title={title} description={description} path="/resenas/" jsonLdExtra={jsonLdResenas}>
  <Topbar tagline="Clientes · Est. 2013" />

  <div class="page-title">
    <div class="kick"><span class="sq"></span><span>Lo que dicen</span></div>
    <h1>Clientes que <em>vuelven</em></h1>
    <p class="demo-note" style="margin-top:1rem">
      Reseñas reales de nuestra ficha de Google: <strong>★ 4.6 con 35 opiniones</strong>.
    </p>
  </div>

  <!-- CARRUSEL AUTO -->
  <section style="padding-top:clamp(1.6rem,4vh,2.6rem)">
    <ReviewCarousel />

    <div class="opinion" style="border-style:solid;margin-top:2.4rem;padding:2rem">
      <div>
        <b style="font-size:1.25rem">⭐ Déjanos tu reseña en Google</b>
        <p>
          Toma menos de un minuto: abre el perfil de J-SAN en Google Maps y cuéntanos cómo fue tu experiencia.
          Tu recomendación ayuda a otro venezolano a encontrar un taller de confianza.
        </p>
      </div>
      <div class="f-btns" style="margin:0">
        <a class="cta-a" target="_blank" rel="noopener" href={LINK_MAPS}>Dejar mi reseña ★</a>
        <a class="cta-b" target="_blank" rel="noopener" href={LINK_MAPS}>Ver las 35 reseñas en Google ↗</a>
      </div>
    </div>

    <p style="color:var(--grey-dark);font-size:.78rem;margin-top:1.2rem;max-width:44rem">
      Próximamente: botón directo "escribir reseña" y feed en vivo de Google (requiere verificación del perfil de empresa).
    </p>
  </section>

  <SiteFooter />
</BaseLayout>
