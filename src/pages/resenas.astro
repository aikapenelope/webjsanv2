---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import { RESENAS, SOCIAL, SITE } from '../data/site';

const title = `Reseñas & Opiniones · ${SITE.name} — ★ 4.6 en Google Maps`;
const description =
  'Opiniones y calificaciones reales de clientes de HIDROMÁTICOS J.SAN, C.A. en Caracas (★ 4.6 con más de 35 reseñas en Google Maps). Experiencias reales de reparación de cajas automáticas.';

const mapsUrl = SOCIAL.find((s) => s.nombre === 'Cómo llegar')?.url ?? 'https://www.google.com/maps/search/?api=1&query=Hidrom%C3%A1ticos+J-SAN+C.A.+Monte+Cristo+Miranda+Caracas+Venezuela';

const jsonLdResenas = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Servicio de transmisión automática — HIDROMÁTICOS J.SAN, C.A.',
  brand: { '@type': 'Brand', name: 'HIDROMÁTICOS J.SAN, C.A.' },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.6',
    reviewCount: '35',
    bestRating: '5',
    worstRating: '1',
  },
  review: RESENAS.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.nombre },
    reviewBody: r.texto,
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
  })),
};
---

<BaseLayout title={title} description={description} path="/resenas/" jsonLdExtra={jsonLdResenas} topbarTagline="Clientes & Calificaciones">
  <main class="resenas-page">
    <div class="wrap">
      <!-- HEADER RESEÑAS -->
      <div class="resenas-hero">
        <span class="kicker">Testimonios Verificados</span>
        <h1>Clientes que <em>recomiendan y vuelven</em></h1>
        <p class="resenas-lead">
          Puntuación promedio de <strong>★ 4.6 con más de 35 opiniones</strong> en nuestro perfil oficial de Google Maps en Caracas.
        </p>
      </div>

      <!-- BADGE SCORE RESUMEN -->
      <div class="score-banner">
        <div class="score-main">
          <span class="score-num">4.6</span>
          <div>
            <div class="score-stars">★★★★★</div>
            <span class="score-label">Promedio de calificación en Google Maps</span>
          </div>
        </div>
        <div class="score-cta">
          <a class="btn btn-primary" href={mapsUrl} target="_blank" rel="noopener">
            Escribir una reseña en Google Maps ↗
          </a>
        </div>
      </div>
    </div>

    <!-- CARRUSEL FLUIDO -->
    <div class="resenas-carousel-wrap">
      <ReviewCarousel />
    </div>

    <div class="wrap">
      <!-- GRID DE RESEÑAS CON PAGINACIÓN INTERACTIVA (9 INICIALES + VER MÁS) -->
      <div class="reviews-full-grid" id="reviews-grid">
        {RESENAS.map((r, idx) => (
          <article class:list={['r-card', idx >= 9 && 'r-card-extra']}>
            <div class="r-header">
              <span class="r-stars">★★★★★</span>
              <span class="r-badge">{r.fuente}</span>
            </div>
            <p class="r-quote">“{r.texto}”</p>
            <div class="r-author">
              <span class="r-avatar">{r.iniciales}</span>
              <div>
                <b>{r.nombre}</b>
                <small>{r.meta}</small>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- BOTÓN VER MÁS RESEÑAS -->
      <div class="ver-mas-wrap" id="ver-mas-container">
        <button class="btn btn-ghost btn-ver-mas" id="btn-ver-mas-resenas">
          <span>Ver más reseñas ({RESENAS.length - 9} opiniones adicionales)</span>
          <span class="btn-arrow-down" aria-hidden="true">↓</span>
        </button>
      </div>

      <!-- BOX DE INVITACIÓN -->
      <div class="opinion-box">
        <div>
          <h3>⭐ ¿Ya atendiste tu vehículo en J-SAN?</h3>
          <p>Toma menos de un minuto: entra en Google Maps y cuéntanos cómo fue tu experiencia con el diagnóstico y la reparación. Tu recomendación ayuda a otros conductores de Caracas a elegir un taller serio.</p>
        </div>
        <div class="opinion-btns">
          <a class="btn btn-gold" href={mapsUrl} target="_blank" rel="noopener">
            Dejar mi reseña en Google ★
          </a>
          <a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener">
            Ver todas las opiniones en Google ↗
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .resenas-page {
    padding: clamp(2.6rem, 6vw, 4.2rem) 0 clamp(3rem, 7vw, 5.2rem);
    background: #ffffff;
  }

  .resenas-hero {
    max-width: 48rem;
    margin-bottom: 2.8rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 4.1rem);
    line-height: 0.98;
    text-transform: uppercase;
    color: var(--navy);
  }

  h1 em {
    font-style: normal;
    color: var(--blue);
  }

  .resenas-lead {
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.6;
    margin-top: 1rem;
    max-width: 40rem;
  }

  /* SCORE BANNER */
  .score-banner {
    background: var(--navy);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.2rem 2.6rem;
    color: #ffffff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    box-shadow: 0 14px 34px rgba(10, 30, 64, 0.18);
    margin-bottom: 2.8rem;
    flex-wrap: wrap;
    position: relative;
    overflow: hidden;
  }

  .score-banner::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold) 0%, rgba(201, 162, 39, 0) 55%);
  }

  .score-main {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .score-num {
    font-family: var(--font-display);
    font-size: 3.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--gold);
  }

  .score-stars {
    color: var(--gold);
    letter-spacing: 0.2rem;
    font-size: 1.4rem;
  }

  .score-label {
    font-size: 0.92rem;
    color: var(--muted-dark);
  }

  .resenas-carousel-wrap {
    margin-bottom: 3.6rem;
  }

  /* GRID FULL */
  .reviews-full-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
    margin-bottom: 2.4rem;
  }

  .r-card {
    background: #ffffff;
    border: 1.5px solid var(--sky-line);
    border-top: 3.5px solid var(--gold);
    border-radius: var(--radius);
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 24px rgba(15, 42, 87, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .r-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(15, 42, 87, 0.12);
  }

  /* OCULTAS INICIALMENTE (DESDE LA 10 EN ADELANTE) */
  .r-card.r-card-extra {
    display: none;
  }

  .r-card.r-card-extra.visible {
    display: flex;
    animation: fadeInReview 0.35s ease forwards;
  }

  @keyframes fadeInReview {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .r-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.9rem;
  }

  .r-stars {
    color: var(--gold);
    font-size: 1.05rem;
    letter-spacing: 0.12rem;
  }

  .r-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    background: var(--blue-soft);
    border: 1px solid rgba(45, 88, 147, 0.15);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .r-quote {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.55;
    flex: 1;
    margin-bottom: 1.4rem;
  }

  .r-author {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sky-line);
  }

  .r-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--gold-soft);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-family: var(--font-display);
    font-size: 0.95rem;
    flex: none;
  }

  .r-author b {
    display: block;
    color: var(--navy);
    font-size: 0.95rem;
  }

  .r-author small {
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* BOTÓN VER MÁS */
  .ver-mas-wrap {
    text-align: center;
    margin: 1.5rem 0 3.8rem;
  }

  .btn-ver-mas {
    padding: 0.85rem 2.2rem;
    font-size: 1rem;
    border-color: var(--blue);
    color: var(--blue);
    background: #ffffff;
    box-shadow: 0 4px 14px rgba(45, 88, 147, 0.08);
  }

  .btn-ver-mas:hover {
    background: var(--blue);
    color: #ffffff;
    border-color: var(--blue);
  }

  .btn-arrow-down {
    font-size: 1.2rem;
    line-height: 1;
    font-weight: 900;
  }

  /* OPINION BOX */
  .opinion-box {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: 20px;
    padding: 2.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    box-shadow: var(--shadow-card);
    flex-wrap: wrap;
    position: relative;
    overflow: hidden;
  }

  .opinion-box::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold) 0%, rgba(201, 162, 39, 0.35) 22%, transparent 55%);
    opacity: 0.6;
    pointer-events: none;
  }

  .opinion-box h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.65rem;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.4rem;
  }

  .opinion-box p {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.55;
    max-width: 36rem;
  }

  .opinion-btns {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  @media (max-width: 960px) {
    .reviews-full-grid {
      grid-template-columns: 1fr;
    }

    .opinion-box {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.8rem;
    }
  }

  @media (max-width: 600px) {
    .resenas-page {
      padding: 3rem 0 4rem;
    }
    .score-banner {
      padding: 1.6rem 1.4rem;
      flex-direction: column;
      align-items: flex-start;
    }
    .score-cta, .opinion-btns, .btn-ver-mas {
      width: 100%;
    }
    .score-cta .btn, .opinion-btns .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  function setupReviewsToggle() {
    const btn = document.getElementById('btn-ver-mas-resenas');
    const container = document.getElementById('ver-mas-container');
    const extraCards = document.querySelectorAll<HTMLElement>('.r-card.r-card-extra');

    if (!btn || extraCards.length === 0) return;

    btn.addEventListener('click', () => {
      extraCards.forEach((card) => {
        card.classList.add('visible');
      });
      if (container) {
        container.style.display = 'none';
      }
    });
  }

  setupReviewsToggle();
  document.addEventListener('astro:page-load', setupReviewsToggle);
</script>
