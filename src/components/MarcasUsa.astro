---
import { MARCAS_USA } from '../data/site';
---

<section id="repuestos" class="usa-section section section-sky">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Calidad de Importación</span>
      <h2 class="sec-title">Componentes originales de las marcas líderes de EE.UU.</h2>
      <p class="sec-lead">
        En cada reparación instalamos repuestos certificados de los mismos fabricantes de equipo original y aftermarket de alto rendimiento en Estados Unidos.
      </p>
    </div>

    <div class="usa-grid">
      {MARCAS_USA.map((m) => (
        <a
          class="usa-card"
          href={m.url}
          target="_blank"
          rel="noopener"
          aria-label={`${m.nombre} — sitio oficial del fabricante`}
        >
          <div class="usa-card-img">
            <img
              src={`/assets/marcas-usa/${m.slug}.png`}
              alt={`Logo ${m.nombre}`}
              loading="lazy"
              width="200"
              height="60"
            />
          </div>
          <h3>{m.nombre}</h3>
          <p>{m.desc}</p>
          <span class="usa-link-label">Sitio oficial {m.nombre.toLowerCase()}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .usa-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.4rem;
  }

  .usa-card {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    padding: 2rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .usa-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(45, 88, 147, 0.35);
  }

  .usa-card-img {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.1rem;
    padding: 0.7rem 1rem;
    background: var(--sky);
    border: 1px solid var(--sky-line);
    border-radius: 12px;
    width: 100%;
  }

  .usa-card-img img {
    max-height: 42px;
    width: auto;
    object-fit: contain;
  }

  .usa-card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.4rem;
  }

  .usa-card p {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
    flex: 1;
    margin-bottom: 1.1rem;
    text-wrap: pretty;
  }

  .usa-link-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.15s ease;
  }

  .usa-link-label::after {
    content: "↗";
    color: var(--gold);
    font-weight: 700;
  }

  .usa-card:hover .usa-link-label {
    color: var(--blue-hover);
  }

  @media (max-width: 960px) {
    .usa-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .usa-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
