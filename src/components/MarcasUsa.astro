---
// Sección "Repuestos originales de EE.UU." — marcas americanas sobre patrón world-dots
import { waLink } from '../data/site';

const MARCAS_USA = [
  {
    nombre: 'Sonnax',
    slug: 'sonnax-dark',
    desc: 'Piezas duras y kits de precisión para transmisiones automáticas.',
    url: 'https://www.sonnax.com/',
  },
  {
    nombre: 'TransGo',
    slug: 'transgo',
    desc: 'Kits correctores de válvulas: el estándar del reparador profesional.',
    url: 'https://transgo.com/',
  },
  {
    nombre: 'Transtec',
    slug: 'transtec',
    desc: 'Kits master y sellos originales para reconstrucción completa.',
    url: 'https://transtec.com/',
  },
  {
    nombre: 'Precision Intl',
    slug: 'precision',
    desc: 'Convertidores de par y componentes de motor importados.',
    url: 'https://www.precisionintl.com/',
  },
];

// Intercalado blanco/negro/blanco/negro: tarjetas alternadas para máximo contraste
const FONDOS = ['blanca', 'negra', 'blanca', 'negra'];

const logo = (slug: string) => `/assets/marcas-usa/${slug}.png`;
---

<section id="marcas-usa" class="usa-section">
  <div class="world-dots" aria-hidden="true"></div>
  <div class="usa-inner">
    <div class="kick"><span class="sq"></span><span>Calidad importada</span></div>
    <h2>Trabajamos con las <em>mejores marcas americanas</em></h2>
    <p class="usa-lead">
      Siempre repuestos originales. Cada reconstrucción que sale de J-SAN lleva componentes de las mismas marcas
      que usan los especialistas de Estados Unidos.
    </p>

    <div class="usa-grid">
      {MARCAS_USA.map((m, i) => (
        <a
          class:list={['usa-card', FONDOS[i] === 'negra' && 'usa-card--negra']}
          href={m.url}
          target="_blank"
          rel="noopener"
          aria-label={`${m.nombre} — sitio oficial`}
        >
          <img src={logo(m.slug)} alt={`Logo ${m.nombre}`} loading="lazy" width="220" height="70" />
          <p>{m.desc}</p>
          <em>{m.nombre.toLowerCase()} ↗</em>
        </a>
      ))}
    </div>

    <div style="margin-top:2rem">
      <a
        class="btn-o"
        style="display:inline-flex;margin-top:0"
        target="_blank"
        rel="noopener"
        href={waLink('Hola J-SAN, quiero cotizar un trabajo con repuestos originales americanos')}
      >
        Cotizar con repuestos originales →
      </a>
    </div>
  </div>
</section>

<style>
  /* ===== SECCIÓN MARCAS AMERICANAS ===== */
  .usa-section{position:relative;background:#fff;color:#16181d;border-bottom:2px solid var(--line);overflow:hidden}
  .usa-inner{position:relative;padding:clamp(3.4rem,7vh,5.5rem) clamp(1.2rem,3vw,2.6rem)}
  .usa-inner .kick span:last-child,.usa-lead{color:#5c5f66}
  .usa-inner h2{font-family:var(--font-display);font-weight:400;font-size:clamp(2rem,4.4vw,3.6rem);line-height:.98;text-transform:uppercase;max-width:24ch;margin:.6rem 0 1rem}
  .usa-inner h2 em{color:var(--orange);font-style:normal}
  .usa-lead{max-width:44rem;font-size:.98rem;line-height:1.6}
  .usa-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem;margin-top:2.2rem}
  .usa-card{
    background:#fff;border:2px solid #e3e5e9;padding:1.6rem 1.2rem;display:flex;flex-direction:column;gap:.8rem;align-items:center;text-align:center;
    transition:border-color .15s ease,transform .15s ease
  }
  .usa-card:hover{border-color:var(--orange);transform:translateY(-3px)}
  .usa-card img{height:56px;width:auto;object-fit:contain}
  .usa-card p{color:#5c5f66;font-size:.85rem;line-height:1.45;flex:1}
  .usa-card em{font-style:normal;font-weight:700;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--orange-deep);border-bottom:2px solid var(--orange)}
  /* tarjetas NEGRAS intercaladas (logo blanco brilla ahí) */
  .usa-card--negra{background:#16181d;border-color:#16181d;color:#fff}
  .usa-card--negra:hover{border-color:var(--orange)}
  .usa-card--negra p{color:#b9bcc3}
  .usa-card--negra em{color:var(--orange);border-bottom-color:var(--orange)}
  @media (max-width:1100px){.usa-grid{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:520px){.usa-grid{grid-template-columns:1fr}}
</style>
