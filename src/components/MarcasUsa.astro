---
import { MARCAS_USA, waLink } from '../data/site';

const waCotizar = waLink('Hola J-SAN, quiero cotizar un trabajo con repuestos originales americanos');
---

<section id="repuestos" class="usa-section">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Calidad importada</span>
      <h2>Trabajamos con las mejores marcas americanas</h2>
      <p>
        Siempre repuestos originales. Cada reconstrucción que sale de J-SAN lleva componentes de las mismas marcas que usan los especialistas de Estados Unidos.
      </p>
    </div>

    <div class="usa-grid">
      {MARCAS_USA.map((m) => (
        <a
          class="usa-card"
          href={m.url}
          target="_blank"
          rel="noopener"
          aria-label={`${m.nombre} — sitio oficial`}
        >
          <div class="usa-card-img">
            <img
              src={`/assets/marcas-usa/${m.slug}.png`}
              alt={`Logo ${m.nombre}`}
              loading="lazy"
              width="200"
              height="60"
            />
          </div>
          <h3>{m.nombre}</h3>
          <p>{m.desc}</p>
          <span class="usa-link-label">{m.nombre.toLowerCase()} ↗</span>
        </a>
      ))}
    </div>

    <div class="usa-cta-wrap">
      <a class="btn btn-primary" href={waCotizar} target="_blank" rel="noopener">
        Cotizar con repuestos originales americanos →
      </a>
    </div>
  </div>
</section>

<style>
  .usa-section {
    padding: 4.8rem 0;
    background: var(--sky);
    border-top: 1px solid var(--sky-line);
    border-bottom: 1px solid var(--sky-line);
  }

  .sec-head {
    max-width: 48rem;
    margin-bottom: 2.8rem;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.03;
    text-transform: uppercase;
    color: var(--navy);
  }

  .sec-head p {
    color: var(--muted);
    margin-top: 0.8rem;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .usa-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.4rem;
  }

  .usa-card {
    background: #ffffff;
    border: 1.5px solid var(--sky-line);
    border-top: 4px solid var(--gold);
    border-radius: var(--radius);
    padding: 2rem 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(15, 42, 87, 0.05);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .usa-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px rgba(15, 42, 87, 0.12);
    border-color: var(--blue);
  }

  .usa-card-img {
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .usa-card-img img {
    max-height: 52px;
    width: auto;
    object-fit: contain;
  }

  .usa-card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.4rem;
  }

  .usa-card p {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
    flex: 1;
    margin-bottom: 1.2rem;
  }

  .usa-link-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    border-bottom: 1.5px solid var(--gold);
    padding-bottom: 0.15rem;
  }

  .usa-cta-wrap {
    margin-top: 2.8rem;
    text-align: center;
  }

  @media (max-width: 960px) {
    .usa-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .usa-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
