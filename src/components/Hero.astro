---
import { waLink } from '../data/site';

const waHero = waLink('Hola J-SAN, quiero consultar por una falla en mi caja automática');
---

<section class="hero" id="inicio">
  <div class="wrap hero-grid">
    <div class="hero-content">
      <span class="kicker">Caracas · Miranda · Desde 2013</span>
      <h1>
        Tu caja automática en manos de <span class="hl">líderes</span>
      </h1>
      <p class="lede">
        Reparamos cajas automáticas y motores, escaneamos fallas computarizado y traemos repuestos importados. Más de una década devolviendo carros a la calle en Miranda.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={waHero} target="_blank" rel="noopener">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .6-.2 1.1Z"/>
          </svg>
          <span>Consultar falla por WhatsApp</span>
        </a>
        <a class="btn btn-ghost" href="#servicios">Ver servicios especializados</a>
      </div>
    </div>

    <div class="hero-side">
      <div class="emblem-stage">
        <img
          src="/assets/logo-jsan.webp"
          alt="Escudo oficial de HIDROMÁTICOS J.SAN, C.A. — Especialistas en cajas automáticas"
          width="320"
          height="295"
          loading="eager"
        />
      </div>
      <div class="float-card">
        <span class="dot" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D5893" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <path d="M8 9h8M8 13h5"/>
          </svg>
        </span>
        <div class="float-text">
          <b>Diagnóstico con Scanner</b>
          <span>Detectamos la falla antes de abrir tu transmisión</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(2.6rem, 6vw, 4.2rem) 0 clamp(3rem, 7vw, 5rem);
    background: #ffffff;
    border-bottom: 1px solid var(--sky-line);
    position: relative;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 3.2rem;
    align-items: center;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--navy);
    text-wrap: balance;
  }

  h1 .hl {
    color: var(--blue);
  }

  .hero p.lede {
    font-size: 1.12rem;
    color: var(--muted);
    max-width: 34rem;
    margin: 1.2rem 0 2rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero-side {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .emblem-stage {
    aspect-ratio: 1 / 0.92;
    border-radius: 20px;
    background: var(--sky);
    border: 1px solid var(--sky-line);
    display: grid;
    place-items: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .emblem-stage img {
    width: min(68%, 300px);
    height: auto;
    filter: drop-shadow(0 14px 22px rgba(10, 30, 64, 0.18));
  }

  .float-card {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1rem 1.2rem;
    display: flex;
    gap: 0.9rem;
    align-items: center;
    max-width: 100%;
  }

  .float-card .dot {
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--blue-soft);
    display: grid;
    place-items: center;
  }

  .float-text b {
    font-size: 0.96rem;
    color: var(--navy);
    display: block;
    line-height: 1.2;
  }

  .float-text span {
    display: block;
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.15rem;
    line-height: 1.35;
  }

  @media (max-width: 960px) {
    .hero {
      padding: 2.6rem 0 3.4rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }

    .hero-side {
      max-width: 26rem;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 2.2rem 0 2.8rem;
    }

    h1 {
      font-size: 2.3rem;
    }

    .hero p.lede {
      font-size: 1rem;
      margin: 1rem 0 1.6rem;
    }

    .hero-ctas {
      flex-direction: column;
      width: 100%;
    }

    .hero-ctas .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>