---
import { waLink } from '../data/site';

const waHero = waLink('Hola J-SAN, quiero consultar por una falla en mi caja automática');
---

<section class="hero" id="inicio">
  <div class="wrap hero-grid">
    <div class="hero-content">
      <span class="eyebrow">★ Caracas · Miranda · Desde 2013</span>
      <h1>
        Tu caja automática en manos de <span class="hl">líderes</span>
      </h1>
      <p class="lede">
        Reparamos cajas automáticas y motores, escaneamos fallas computarizado y traemos repuestos importados. Más de una década devolviendo carros a la calle en Miranda.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={waHero} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .6-.2 1.1Z"/>
          </svg>
          <span>Consultar mi falla por WhatsApp</span>
        </a>
        <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
      </div>
    </div>

    <div class="hero-side">
      <div class="emblem-stage">
        <img
          src="/assets/logo-jsan.webp"
          alt="Escudo corporativo de Hidromáticos J-SAN — Líderes en Transmisiones desde 2013"
          width="340"
          height="314"
          loading="eager"
        />
      </div>
      <div class="float-card">
        <span class="dot" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2159c3" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
        </span>
        <div>
          <b>Diagnóstico con scanner</b>
          <span>Detectamos la falla antes de abrir tu caja</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4.4rem 0 5rem;
    background:
      radial-gradient(circle at 85% 12%, rgba(33, 89, 195, 0.08), transparent 42%),
      linear-gradient(180deg, #ffffff 0%, var(--sky) 130%);
    border-bottom: 1px solid var(--sky-line);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 3.2rem;
    align-items: center;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.8rem, 5.8vw, 4.8rem);
    line-height: 0.96;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--navy);
    text-wrap: balance;
  }

  h1 .hl {
    color: var(--blue);
  }

  .hero p.lede {
    font-size: 1.13rem;
    color: var(--muted);
    max-width: 34rem;
    margin: 1.4rem 0 2.2rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero-side {
    position: relative;
  }

  .emblem-stage {
    aspect-ratio: 1 / 1.04;
    border-radius: 22px;
    background:
      radial-gradient(circle at 50% 44%, rgba(201, 162, 39, 0.16) 0%, transparent 36%),
      repeating-radial-gradient(circle at 50% 46%, rgba(33, 89, 195, 0.08) 0 2px, transparent 2px 34px),
      linear-gradient(180deg, var(--sky), #ffffff);
    border: 1px solid var(--sky-line);
    display: grid;
    place-items: center;
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(15, 42, 87, 0.06);
  }

  .emblem-stage img {
    width: min(74%, 340px);
    height: auto;
    filter: drop-shadow(0 24px 34px rgba(10, 30, 64, 0.22));
    transition: transform 0.3s ease;
  }

  .emblem-stage:hover img {
    transform: scale(1.03);
  }

  .float-card {
    position: absolute;
    bottom: -1.4rem;
    left: -2rem;
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px rgba(15, 42, 87, 0.14);
    padding: 1rem 1.2rem;
    display: flex;
    gap: 0.9rem;
    align-items: center;
    max-width: 19rem;
    animation: floatAnim 4s ease-in-out infinite;
  }

  .float-card .dot {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--sky);
    display: grid;
    place-items: center;
  }

  .float-card b {
    font-size: 0.93rem;
    color: var(--navy);
    display: block;
    line-height: 1.2;
  }

  .float-card span {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  @keyframes floatAnim {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero-side {
      max-width: 26rem;
      margin-inline: auto;
      width: 100%;
    }

    .float-card {
      left: -0.4rem;
      bottom: -1rem;
    }
  }
</style>
