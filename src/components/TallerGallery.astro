---
import { SOCIAL } from '../data/site';

interface CasoTaller {
  titulo: string;
  categoria: string;
  tag: string;
  descripcion: string;
  detalleTecnico: string;
  redUrl: string;
}

const CASOS: CasoTaller[] = [
  {
    titulo: 'Reconstrucción Overhaul de Caja Automática 6 Velocidades',
    categoria: 'Overhaul Completo',
    tag: 'Kit Master Americano',
    descripcion: 'Desarme completo tras pérdida de tracción en 3ra marcha. Sustitución de todos los discos de fricción, pistones vulcanizados y sellos viton.',
    detalleTecnico: 'Caja desarmada pieza por pieza, limpieza química y reemplazo total de juntas.',
    redUrl: 'https://www.instagram.com/hidromaticosjs/',
  },
  {
    titulo: 'Rectificación y Calibración de Cuerpo de Válvulas Sonnax®',
    categoria: 'Sistema Hidráulico',
    tag: 'Sonnax® & TransGo®',
    descripcion: 'Corrección de golpes severos al aplicar Drive y Retroceso mediante instalación de válvulas reguladoras sobredimensionadas.',
    detalleTecnico: 'Prueba de vacío en banco y sustitución de solenoides moduladores de presión.',
    redUrl: 'https://www.threads.net/@hidromaticosjs',
  },
  {
    titulo: 'Apertura, Reconstrucción y Balanceo de Convertidor (Turbina)',
    categoria: 'Convertidor de Par',
    tag: 'Torno & Balanceo',
    descripcion: 'Eliminación de vibraciones a 60-80 km/h (shudder de embrague TCC). Cambio de forro de fricción lock-up y rodamientos axiales.',
    detalleTecnico: 'Soldadura en torno de precisión y prueba hidrostática de estanqueidad.',
    redUrl: 'https://www.facebook.com/HidromaticosJSan/',
  },
  {
    titulo: 'Mantenimiento Preventivo de Fluido ATF & Filtro Interno',
    categoria: 'Servicio Preventivo',
    tag: 'Fluido Certificado',
    descripcion: 'Remoción de cárter con acumulación de sedimentos, sustitución de colador/filtro sellado y recarga de fluido 100% sintético.',
    detalleTecnico: 'Inspección de imanes recolectores de virutas para diagnóstico preventivo.',
    redUrl: 'https://www.instagram.com/hidromaticosjs/',
  },
];

const igUrl = SOCIAL.find((s) => s.nombre === 'Instagram')?.url ?? 'https://www.instagram.com/hidromaticosjs/';
const threadsUrl = SOCIAL.find((s) => s.nombre === 'Threads')?.url ?? 'https://www.threads.net/@hidromaticosjs';
---

<section id="casos-reales" class="gallery-sec section section-sky">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Casos Reales en Taller</span>
      <h2 class="sec-title">Transparencia y precisión mecánica en cada trabajo</h2>
      <p class="sec-lead">Mira cómo desarmamos, diagnosticamos y devolvemos transmisiones a especificaciones de fábrica en nuestra sede de Monte Cristo.</p>
    </div>

    <!-- GRID DE CASOS -->
    <div class="casos-grid">
      {CASOS.map((c) => (
        <article class="caso-card">
          <div class="caso-top">
            <span class="caso-cat">{c.categoria}</span>
            <span class="caso-tag">{c.tag}</span>
          </div>

          <div class="caso-body">
            <h3>{c.titulo}</h3>
            <p class="caso-desc">{c.descripcion}</p>

            <div class="caso-box-tech">
              <span class="tech-label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
                Labor realizada:
              </span>
              <p>{c.detalleTecnico}</p>
            </div>
          </div>

          <div class="caso-foot">
            <a class="caso-link" href={c.redUrl} target="_blank" rel="noopener">
              <span>Ver casos similares en redes</span>
              <span class="caso-link-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- BANNER SOCIAL INSTITUCIONAL -->
    <div class="gallery-social-banner">
      <div class="social-banner-text">
        <span class="social-badge">Contenido diario en redes sociales</span>
        <h3>¿Quieres ver diagnósticos en vivo y carros en prueba de ruta?</h3>
        <p>Publicamos desarmes, explicación de fallas y recomendaciones de mantenimiento en nuestras cuentas oficiales de Instagram y Threads.</p>
      </div>
      <div class="social-banner-btns">
        <a class="btn btn-gold btn-sm" href={igUrl} target="_blank" rel="noopener">
          Seguir en Instagram @hidromaticosjs
        </a>
        <a class="btn btn-white btn-sm" href={threadsUrl} target="_blank" rel="noopener">
          Ver Threads @hidromaticosjs
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .casos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
    margin-bottom: 3rem;
  }

  .caso-card {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: 18px;
    padding: 1.9rem 1.8rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .caso-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold) 0%, rgba(201, 162, 39, 0.35) 22%, transparent 55%);
    opacity: 0.55;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .caso-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(45, 88, 147, 0.35);
  }

  .caso-card:hover::before {
    opacity: 1;
  }

  .caso-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .caso-cat {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
    background: var(--blue-soft);
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
  }

  .caso-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: #8f6f12;
    background: rgba(201, 162, 39, 0.14);
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
  }

  .caso-body {
    flex: 1;
  }

  .caso-body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.65rem;
  }

  .caso-desc {
    font-size: 0.94rem;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 1.1rem;
    text-wrap: pretty;
  }

  .caso-box-tech {
    background: var(--sky);
    border: 1px solid var(--sky-line);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    margin-bottom: 1.2rem;
  }

  .tech-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.25rem;
  }

  .tech-label svg {
    color: var(--gold);
  }

  .caso-box-tech p {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .caso-foot {
    padding-top: 0.9rem;
    border-top: 1px solid var(--sky-line);
  }

  .caso-link {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--blue);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s ease;
  }

  .caso-link-arrow {
    color: var(--gold);
    transition: transform 0.15s ease;
  }

  .caso-link:hover {
    color: var(--blue-hover);
  }

  .caso-link:hover .caso-link-arrow {
    transform: translate(2px, -2px);
  }

  /* BANNER SOCIAL INSTITUCIONAL */
  .gallery-social-banner {
    background: var(--navy);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.4rem 2.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    box-shadow: 0 16px 36px rgba(10, 30, 64, 0.25);
    flex-wrap: wrap;
    position: relative;
    overflow: hidden;
  }

  .gallery-social-banner::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold) 0%, rgba(201, 162, 39, 0) 60%);
  }

  .social-banner-text {
    max-width: 38rem;
    position: relative;
  }

  .social-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-soft);
    display: block;
    margin-bottom: 0.5rem;
  }

  .social-banner-text h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.1;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 0.45rem;
  }

  .social-banner-text p {
    color: var(--muted-dark);
    font-size: 0.96rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .social-banner-btns {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    position: relative;
  }

  @media (max-width: 900px) {
    .casos-grid {
      grid-template-columns: 1fr;
    }
    .gallery-social-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.8rem 1.4rem;
    }
    .social-banner-btns {
      width: 100%;
    }
    .social-banner-btns .btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .caso-card {
      padding: 1.5rem 1.2rem;
    }
  }
</style>