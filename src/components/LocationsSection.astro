---
import { SITE, SOCIAL, waLink } from '../data/site';

const mapsUrl = SOCIAL.find((s) => s.nombre === 'Cómo llegar')?.url ?? 'https://www.google.com/maps/search/?api=1&query=Hidrom%C3%A1ticos+J-SAN+C.A.+Monte+Cristo+Miranda+Caracas+Venezuela';
const waAgendar = waLink('Hola J-SAN, quiero agendar una cita para revisión y diagnóstico en su taller de Monte Cristo');
---

<section id="sedes" class="locations-sec section section-white">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Sede Principal en Caracas</span>
      <h2 class="sec-title">Visítanos en nuestro taller en Monte Cristo</h2>
      <p class="sec-lead">Instalaciones equipadas con elevadores, fosa mecánica y scanner computarizado para atención directa y resguardo seguro de tu carro.</p>
    </div>

    <div class="loc-card-main">
      <div class="loc-grid-top">
        <div class="loc-info-col">
          <div class="loc-header">
            <span class="loc-tag">Sede Central · Monte Cristo</span>
            <h3>HIDROMÁTICOS J.SAN, C.A.</h3>
            <span class="loc-status-pill">
              <span class="loc-status-dot" aria-hidden="true"></span>
              Abierto Lun–Sáb · 8:00 AM a 5:00 PM
            </span>
          </div>

          <div class="loc-details">
            <div class="loc-detail-box">
              <span class="loc-label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2a8 8 0 0 0-8 8c0 5.4 8 12 8 12s8-6.6 8-12a8 8 0 0 0-8-8Z"/><circle cx="12" cy="10" r="3"/>
                </svg>
                Dirección Exacta:
              </span>
              <address>{SITE.sede}</address>
              <span class="loc-ref"><strong>Punto de referencia:</strong> Urb. Monte Cristo, Qta. Leonor Nro. 3, Los Ruices, Caracas.</span>
            </div>

            <div class="loc-detail-box">
              <span class="loc-label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/>
                </svg>
                Canales de Atención Directa:
              </span>
              <div class="loc-phones">
                <div>
                  <small class="phone-tag">WhatsApp Citas & Diagnóstico:</small>
                  <a class="phone-wa" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">{SITE.whatsappDisplay}</a>
                </div>
                <div>
                  <small class="phone-tag">Correo Electrónico:</small>
                  <a href={`mailto:${SITE.email}`} class="phone-mail">{SITE.email}</a>
                </div>
              </div>
            </div>

            <div class="loc-detail-box">
              <span class="loc-label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/><path d="m16 8-3 6-6 2 3-6 6-2Z"/>
                </svg>
                Rutas y Accesos Rápidos:
              </span>
              <ul class="loc-routes">
                <li>
                  <b>Desde la Cota Mil:</b> Bajada por Sebucán / Los Dos Caminos hacia la 3ra transversal de Monte Cristo (3 min).
                </li>
                <li>
                  <b>Desde la Av. Fco. de Miranda:</b> Subiendo por Los Dos Caminos o La California (4 min).
                </li>
              </ul>
            </div>
          </div>

          <div class="loc-actions">
            <a class="btn btn-primary btn-sm" href={mapsUrl} target="_blank" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a8 8 0 0 0-8 8c0 5.4 8 12 8 12s8-6.6 8-12a8 8 0 0 0-8-8Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Abrir en Google Maps ↗</span>
            </a>
            <a class="btn btn-gold btn-sm" href={waAgendar} target="_blank" rel="noopener">
              <span>Agendar cita previa por WhatsApp →</span>
            </a>
          </div>
        </div>

        <!-- MINI MAPA INTERACTIVO / RESPONSIVE MAP EMBED (CARGA DIFERIDA) -->
        <div class="loc-map-col">
          <div class="map-frame-wrapper">
            <div
              class="map-embed"
              data-lazy-embed
              data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3923.0039209539316!2d-66.83999!3d10.4965!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8c2a584065604169%3A0xc31633cf4839cf9e!2sHidromaticos%20J-San%2C%20C.A.!5e0!3m2!1ses!2sve!4v1700000000000!5m2!1ses!2sve"
              data-auto="desktop"
              data-timeout-ms="12000"
              data-frame-class="map-embed-frame"
              data-frame-title="Ubicación de Hidromáticos J-SAN en Monte Cristo Caracas"
              data-frame-allow="fullscreen"
              data-frame-allow-fullscreen="true"
            >
              <!-- FACHADA: 0 KB de Google Maps hasta que el usuario lo pide -->
              <div class="map-facade" data-lazy-embed-facade>
                <span class="map-facade-pin" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a8 8 0 0 0-8 8c0 5.4 8 12 8 12s8-6.6 8-12a8 8 0 0 0-8-8Z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </span>
                <strong class="map-facade-title">Monte Cristo, Los Ruices</strong>
                <span class="map-facade-sub">Qta. Leonor Nro. 3 · Caracas</span>
                <div class="map-facade-actions">
                  <button type="button" class="btn btn-primary btn-sm" data-lazy-embed-load>
                    Ver mapa aquí
                  </button>
                  <a class="btn btn-ghost btn-sm" href={mapsUrl} target="_blank" rel="noopener">
                    Google Maps ↗
                  </a>
                </div>
              </div>

              <div class="map-state" data-lazy-embed-loading role="status" aria-live="polite" hidden>
                <div class="map-spinner" aria-hidden="true"></div>
                <span>Cargando mapa interactivo…</span>
              </div>

              <div class="map-state map-state-error" data-lazy-embed-error role="alert" hidden>
                <span>No pudimos cargar el mapa aquí.</span>
                <a class="btn btn-primary btn-sm" href={mapsUrl} target="_blank" rel="noopener">
                  Abrir en Google Maps ↗
                </a>
              </div>

              <div class="map-slot" data-lazy-embed-slot hidden></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .loc-card-main {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: 20px;
    padding: 1.8rem 2rem;
    box-shadow: var(--shadow-card);
    position: relative;
    overflow: hidden;
  }

  .loc-card-main::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold) 0%, rgba(201, 162, 39, 0.35) 22%, transparent 55%);
    opacity: 0.6;
    pointer-events: none;
  }

  .loc-grid-top {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .loc-info-col {
    display: flex;
    flex-direction: column;
  }

  .loc-header {
    margin-bottom: 1.4rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--sky-line);
  }

  .loc-tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue);
    background: var(--blue-soft);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .loc-header h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.2vw, 2.3rem);
    text-transform: uppercase;
    color: var(--navy);
    line-height: 1.1;
    margin-bottom: 0.4rem;
  }

  .loc-status-pill {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--green);
    background: rgba(23, 138, 66, 0.08);
    border: 1px solid rgba(23, 138, 66, 0.22);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .loc-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    flex: none;
  }

  .loc-details {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    flex: 1;
    margin-bottom: 1.6rem;
  }

  .loc-detail-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .loc-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.2rem;
  }

  .loc-label svg {
    color: var(--gold);
  }

  .loc-detail-box address {
    font-style: normal;
    color: var(--navy);
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .loc-ref {
    font-size: 0.84rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .loc-phones {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .loc-phones > div {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .phone-tag {
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 600;
  }

  .loc-phones a {
    color: var(--blue);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .loc-phones a:hover {
    text-decoration: underline;
  }

  .phone-wa {
    color: #16a34a !important;
    font-weight: 800 !important;
  }

  .sep {
    color: var(--muted);
  }

  .loc-routes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .loc-routes li::before {
    content: "•";
    color: var(--gold);
    font-weight: 900;
    margin-right: 0.4rem;
  }

  .loc-routes b {
    color: var(--navy);
  }

  .loc-actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    padding-top: 1.4rem;
    border-top: 1px solid var(--sky-line);
  }

  /* MAPA EMBED */
  .loc-map-col {
    display: flex;
    min-height: 340px;
  }

  .map-frame-wrapper {
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    border: 1.5px solid var(--sky-line);
    box-shadow: 0 8px 24px rgba(15, 42, 87, 0.08);
    background: var(--sky);
  }

  .map-embed {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 330px;
  }

  /* El slot no genera caja: el iframe queda como hijo directo del contenedor
     y hereda el layout 100% alto que ya existía antes de la carga diferida. */
  .map-slot {
    display: contents;
  }

  .map-slot[hidden],
  .map-facade[hidden],
  .map-state[hidden] {
    display: none;
  }

  /* Iframe inyectado por JS: requiere :global() para no depender del scoping. */
  .map-frame-wrapper :global(iframe) {
    width: 100%;
    height: 100%;
    min-height: 330px;
    display: block;
  }

  /* FACHADA DEL MAPA (sin red de Google hasta que el usuario la pide) */
  .map-facade {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    text-align: center;
    padding: 1.4rem 1.1rem;
    background:
      radial-gradient(circle at 50% 34%, rgba(45, 88, 147, 0.12), transparent 58%),
      repeating-linear-gradient(45deg, rgba(15, 42, 87, 0.03) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(-45deg, rgba(15, 42, 87, 0.03) 0 1px, transparent 1px 22px),
      var(--sky);
  }

  .map-facade-pin {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #ffffff;
    color: var(--blue-corporate);
    border: 1px solid var(--sky-line);
    box-shadow: var(--shadow-card);
    margin-bottom: 0.35rem;
  }

  .map-facade-pin svg {
    width: 24px;
    height: 24px;
  }

  .map-facade-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--navy);
    line-height: 1.1;
  }

  .map-facade-sub {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .map-facade-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.85rem;
  }

  .map-state {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 1.2rem;
    text-align: center;
    background: var(--sky);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--muted);
  }

  .map-spinner {
    width: 30px;
    height: 30px;
    border: 3px solid var(--sky-line);
    border-top-color: var(--blue-corporate);
    border-radius: 50%;
    animation: map-spin 0.8s linear infinite;
  }

  @keyframes map-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 960px) {
    .loc-grid-top {
      grid-template-columns: 1fr;
    }
    .loc-map-col {
      min-height: 300px;
    }
  }

  @media (max-width: 640px) {
    .locations-sec {
      padding: 3.4rem 0;
    }

    .loc-card-main {
      padding: 1.6rem 1.3rem;
    }

    .loc-actions {
      flex-direction: column;
      width: 100%;
    }

    .loc-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  import { setupLazyEmbeds } from '../lib/lazyEmbed';

  setupLazyEmbeds();
  document.addEventListener('astro:page-load', setupLazyEmbeds);
</script>

