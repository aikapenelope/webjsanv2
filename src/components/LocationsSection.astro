---
import { SITE, SOCIAL, waLink } from '../data/site';

const mapsUrl = SOCIAL.find((s) => s.nombre === 'Cómo llegar')?.url ?? '#';
const waAgendar = waLink('Hola J-SAN, quiero agendar una cita para revisión y diagnóstico en su taller de Monte Cristo');
---

<section id="sedes" class="locations-sec">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Taller &amp; Oficinas</span>
      <h2>Visítanos en nuestra sede en Caracas</h2>
      <p>Instalaciones equipadas con elevadores, fosa mecánica y scanner computarizado para atención directa de tu vehículo.</p>
    </div>

    <div class="loc-card-main">
      <div class="loc-header">
        <div class="loc-title-group">
          <span class="loc-tag">SEDE CENTRAL · CARACAS</span>
          <h3>Taller &amp; Oficina Monte Cristo</h3>
        </div>
        <span class="loc-status-pill">● Abierto Lun-Sáb con cita previa</span>
      </div>

      <div class="loc-details-grid">
        <div class="loc-detail-box">
          <span class="loc-label">📍 Dirección Exacta</span>
          <address>
            {SITE.sede}
          </address>
          <span class="loc-ref">Referencia: Justo frente a Campi Ferretería.</span>
        </div>

        <div class="loc-detail-box">
          <span class="loc-label">🕒 Horario de Atención</span>
          <p class="loc-val">{SITE.horario}</p>
          <span class="loc-ref">Recomendamos agendar vía WhatsApp para evitar esperas.</span>
        </div>

        <div class="loc-detail-box">
          <span class="loc-label">📞 Teléfonos Directos</span>
          <div class="loc-phones">
            <a href={`tel:${SITE.phoneOficina1}`}>{SITE.phoneOficina1Display}</a>
            <span class="sep" aria-hidden="true">·</span>
            <a href={`tel:${SITE.phoneOficina2}`}>{SITE.phoneOficina2Display}</a>
          </div>
          <span class="loc-ref">Líneas fijas de recepción y taller.</span>
        </div>
      </div>

      <div class="loc-actions">
        <a class="btn btn-primary" href={mapsUrl} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a8 8 0 0 0-8 8c0 5.4 8 12 8 12s8-6.6 8-12a8 8 0 0 0-8-8Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Abrir ubicación en Google Maps ↗</span>
        </a>
        <a class="btn btn-gold" href={waAgendar} target="_blank" rel="noopener">
          <span>Agendar cita por WhatsApp →</span>
        </a>
        <a class="btn btn-ghost" href={`tel:${SITE.phoneOficina1}`}>
          <span>Llamar a recepción</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .locations-sec {
    padding: 4.8rem 0;
    background: #ffffff;
    border-top: 1px solid var(--sky-line);
  }

  .sec-head {
    max-width: 48rem;
    margin-bottom: 2.6rem;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.4vw, 3.2rem);
    line-height: 1.02;
    text-transform: uppercase;
    color: var(--navy);
  }

  .sec-head p {
    color: var(--muted);
    margin-top: 0.8rem;
    font-size: 1.06rem;
    line-height: 1.55;
  }

  .loc-card-main {
    background: linear-gradient(180deg, #ffffff 0%, var(--sky) 100%);
    border: 1.5px solid var(--sky-line);
    border-top: 5px solid var(--gold);
    border-radius: 20px;
    padding: 2.8rem 2.6rem;
    box-shadow: 0 14px 36px rgba(15, 42, 87, 0.08);
  }

  .loc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.4rem;
    margin-bottom: 2.2rem;
    padding-bottom: 1.8rem;
    border-bottom: 1px solid var(--sky-line);
    flex-wrap: wrap;
  }

  .loc-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    background: var(--navy);
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .loc-header h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    text-transform: uppercase;
    color: var(--navy);
    line-height: 1.1;
  }

  .loc-status-pill {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--green);
    background: rgba(23, 138, 66, 0.1);
    border: 1px solid rgba(23, 138, 66, 0.2);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .loc-details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 2.4rem;
  }

  .loc-detail-box {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .loc-label {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .loc-detail-box address,
  .loc-val {
    font-style: normal;
    color: var(--navy);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.45;
  }

  .loc-ref {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
    margin-top: 0.2rem;
  }

  .loc-phones {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .loc-phones a {
    color: var(--blue);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .loc-phones a:hover {
    text-decoration: underline;
  }

  .sep {
    color: var(--muted);
  }

  .loc-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.8rem;
    border-top: 1px solid var(--sky-line);
  }

  @media (max-width: 960px) {
    .loc-details-grid {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
  }

  @media (max-width: 640px) {
    .locations-sec {
      padding: 3.4rem 0;
    }

    .loc-card-main {
      padding: 1.8rem 1.4rem;
    }

    .loc-actions {
      flex-direction: column;
      width: 100%;
    }

    .loc-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
