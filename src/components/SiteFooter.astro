---
import { SITE, SOCIAL } from '../data/site';
---

<footer role="contentinfo">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand-col">
        <div class="foot-logo">
          <img
            src="/assets/logo-jsan.webp"
            alt="Escudo oficial de HIDROMÁTICOS J.SAN, C.A."
            width="80"
            height="74"
            loading="lazy"
          />
        </div>
        <div class="foot-brand-sub">
          <strong class="foot-company-name">{SITE.name}</strong>
          <span class="foot-rif">RIF: {SITE.rif}</span>
          <p class="foot-slogan">Líderes en Diagnóstico y Reparación de Transmisiones Automáticas · Desde {SITE.fundacion}</p>
        </div>
      </div>

      <div>
        <h4>Servicios Especializados</h4>
        <ul>
          <li><a href="/#servicios">Diagnóstico computarizado (Scanner DTC)</a></li>
          <li><a href="/#servicios">Reparación de cajas automáticas</a></li>
          <li><a href="/#servicios">Reconstrucción total (Overhaul Master)</a></li>
          <li><a href="/#servicios">Mantenimiento de fluido y filtro ATF</a></li>
          <li><a href="/#servicios">Cuerpo de válvulas y solenoides</a></li>
          <li><a href="/#repuestos">Repuestos importados americanos</a></li>
        </ul>
      </div>

      <div>
        <h4>Navegación & Empresa</h4>
        <ul>
          <li><a href="/nosotros/">Sobre Nosotros (Propósito & Valores)</a></li>
          <li><a href="/resenas/">Reseñas de Clientes (Google ★ 4.6)</a></li>
          <li><a href="/videos/">Videos y Trabajos en Taller</a></li>
          <li><a href="/blog/">Blog y Guías Mecánicas</a></li>
          <li><a href="/terminos/">Términos de Garantía y Servicio</a></li>
          <li><a href="/contacto/">Canales de Contacto Directo</a></li>
        </ul>
      </div>

      <div>
        <h4>Sede Monte Cristo & Contacto</h4>
        <div class="foot-contact-box">
          <p>
            <strong>Dirección en Caracas:</strong><br />
            {SITE.sede}
          </p>
          <p>
            <strong>Teléfonos de Oficina:</strong><br />
            <a href={`tel:${SITE.phoneOficina1}`}>{SITE.phoneOficina1Display}</a> · <a href={`tel:${SITE.phoneOficina2}`}>{SITE.phoneOficina2Display}</a><br />
            WhatsApp: <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">{SITE.whatsappDisplay}</a>
          </p>
          <p>
            <strong>Horario:</strong><br />
            {SITE.horario}
          </p>
          <div class="foot-socials">
            {SOCIAL.map((s) => (
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.nombre}>
                {s.nombre} ↗
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="foot-legal">
      <span>© {SITE.fundacion}–2026 <strong>{SITE.name}</strong> · RIF: {SITE.rif} · Todos los derechos reservados.</span>
      <div class="foot-links-legal">
        <a href="/terminos/">Términos de Servicio & Garantías por Escrito</a>
        <span aria-hidden="true">·</span>
        <span>Caracas, Miranda, Venezuela</span>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--navy-deep);
    color: var(--muted-dark);
    padding: 3.8rem 0 2.2rem;
    font-size: 0.9rem;
    border-top: 3px solid var(--gold);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.3fr;
    gap: 2.4rem;
    margin-bottom: 2.6rem;
    align-items: start;
  }

  .foot-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .foot-logo {
    background: #ffffff;
    border-radius: 14px;
    padding: 0.65rem;
    width: 88px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .foot-logo img {
    width: 100%;
    height: auto;
  }

  .foot-brand-sub {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--muted-dark);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .foot-company-name {
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .foot-rif {
    color: var(--gold-soft);
    font-weight: 700;
    font-size: 0.88rem;
    background: rgba(201, 162, 39, 0.15);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    align-self: flex-start;
  }

  .foot-slogan {
    color: #b0bfdc;
    font-size: 0.84rem;
    margin-top: 0.2rem;
  }

  footer h4 {
    color: #ffffff;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 1.12rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 0.45rem;
  }

  footer ul {
    list-style: none;
  }

  footer li {
    padding: 0.32rem 0;
  }

  footer a {
    color: var(--muted-dark);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  footer a:hover {
    color: var(--gold-soft);
    text-decoration: underline;
  }

  .foot-contact-box {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .foot-contact-box strong {
    color: #ffffff;
  }

  .foot-socials {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
    font-size: 0.84rem;
  }

  .foot-socials a {
    color: var(--gold-soft);
    font-weight: 700;
  }

  .foot-socials a:hover {
    color: #ffffff;
  }

  .foot-legal {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: 1.6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
  }

  .foot-legal strong {
    color: #ffffff;
  }

  .foot-links-legal {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  @media (max-width: 1040px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    footer {
      padding: 2.8rem 0 1.8rem;
    }
    .foot-grid {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
    .foot-legal {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
  }
</style>
