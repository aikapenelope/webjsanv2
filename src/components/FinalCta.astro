---
import { SITE, waLink } from '../data/site';

const waFinal = waLink('Hola J-SAN, quiero consultar por una falla en mi caja automática');
---

<section class="final-cta" aria-label="Llamado a la acción final">
  <div class="wrap final-inner">
    <div class="final-text">
      <h2>¿Sientes que tu caja patina, golpea o tiene una fuga?</h2>
      <p>Escríbenos ahora con la marca, modelo y año de tu carro. Te asesoramos sin compromiso.</p>
    </div>
    <div class="final-actions">
      <a class="btn btn-primary" href={waFinal} target="_blank" rel="noopener">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .6-.2 1.1Z"/>
        </svg>
        <span>Chatear por WhatsApp ({SITE.whatsappDisplay})</span>
      </a>
      <a class="btn btn-ghost" href={`tel:${SITE.phoneOficina1}`}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/>
        </svg>
        <span>Llamar a oficina: {SITE.phoneOficina1Display}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: var(--navy);
    border-top: 1px solid rgba(201, 162, 39, 0.45);
    padding: clamp(3.2rem, 7vw, 4.8rem) 0;
    color: #ffffff;
  }

  .final-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.4rem;
    flex-wrap: wrap;
  }

  .final-text {
    max-width: 36rem;
  }

  .final-text h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: #ffffff;
    text-wrap: balance;
  }

  .final-text p {
    margin-top: 0.8rem;
    font-size: 1.08rem;
    color: var(--muted-dark);
    line-height: 1.5;
  }

  .final-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: min(26rem, 100%);
  }

  .final-actions .btn {
    width: 100%;
    justify-content: center;
    align-items: center;
  }

  .final-actions .btn svg {
    flex: none;
  }

  @media (max-width: 768px) {
    .final-cta {
      padding: 3rem 0;
    }
    .final-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.8rem;
    }
    .final-actions {
      width: 100%;
    }
  }
</style>
