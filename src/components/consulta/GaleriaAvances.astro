---
/**
 * Pestaña "Avances del Trabajo" — contenedor.
 * El timeline y las fotos se pintan desde `consulta-client.ts` con los datos
 * de la API (`ordenes[0].avances`). Solo se muestran fecha, etapa y fotos.
 */
---

<section class="cq-avances" id="cq-avances" aria-labelledby="cq-avances-title">
  <header class="cq-avances-head">
    <div class="cq-avances-title">
      <h3 id="cq-avances-title">Avances del trabajo</h3>
      <p class="cq-avances-ultima" data-campo="ultima" hidden></p>
    </div>
    <span class="cq-avances-total" data-campo="total" hidden></span>
  </header>

  <div class="cq-avances-acciones" data-campo="acciones" hidden>
    <button type="button" class="cq-avances-accion" data-accion="ver-inicio">Ver desde el inicio</button>
    <button type="button" class="cq-avances-accion" data-accion="ver-ultimo">Ir al último avance</button>
  </div>

  <p class="cq-avances-vacio" data-campo="vacio">
    Aún no hay fotos de avance. Cuando el especialista las suba, aparecerán aquí.
  </p>

  <p class="cq-avances-sin-acceso" data-campo="sin-acceso" hidden>
    <span data-campo="sin-acceso-texto"></span>
    <a data-campo="sin-acceso-wa" href="https://wa.me/584141066546" target="_blank" rel="noopener">
      Escríbenos por WhatsApp
    </a>
  </p>

  <div class="cq-avances-timeline" data-campo="timeline"></div>
</section>

<style is:global>
  /* `is:global`: el timeline se crea desde JS y no lleva el scope de Astro
     (`data-astro-cid-…`); con `<style>` normal estas reglas no se aplicaban. */
  .cq-avances {
    display: grid;
    gap: 1.1rem;
    min-width: 0;
  }

  .cq-avances-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cq-avances-title h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--navy);
  }

  .cq-avances-ultima {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .cq-avances-total {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    border: 1px solid #cddff5;
    background: #ffffff;
    color: var(--blue);
    font-size: 0.78rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cq-avances-vacio {
    margin: 0;
    padding: 1rem;
    border: 1px dashed var(--sky-line);
    border-radius: var(--radius-sm);
    background: var(--sky);
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    text-align: center;
  }

  .cq-avances-sin-acceso {
    margin: 0;
    padding: 0.8rem 1rem;
    border-left: 3px solid var(--gold);
    border-radius: var(--radius-sm);
    background: #fffaf0;
    color: var(--navy);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .cq-avances-sin-acceso a {
    color: var(--blue);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cq-avances-timeline {
    display: grid;
    gap: 0.85rem;
    min-width: 0;
  }

  .cq-avances-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cq-avances-acciones[hidden] {
    display: none;
  }

  .cq-avances-accion {
    min-height: 36px;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--sky-line);
    border-radius: 999px;
    background: #ffffff;
    color: var(--blue);
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      color 0.15s ease;
  }

  .cq-avances-accion:hover {
    border-color: var(--blue);
    background: var(--sky);
  }

  .cq-avances-accion:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  .cq-etapa {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--sky-line);
    border-radius: 14px;
    background: #ffffff;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cq-etapa.is-abierta {
    border-color: #c7d9ef;
    box-shadow: 0 12px 26px -20px rgba(15, 42, 87, 0.55);
  }

  .cq-etapa.is-actual::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--gold), var(--gold-soft));
    z-index: 2;
  }

  .cq-etapa-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    width: 100%;
    min-height: 52px;
    padding: 0.8rem 0.95rem 0.8rem 1rem;
    border: 0;
    background: linear-gradient(180deg, #fbfdff, var(--sky));
    color: var(--navy);
    font-family: var(--font-body);
    text-align: left;
    cursor: pointer;
  }

  .cq-etapa.is-abierta .cq-etapa-head {
    background: #ffffff;
    border-bottom: 1px solid var(--sky-line);
  }

  .cq-etapa-head:hover {
    background: #e9f2fc;
  }

  .cq-etapa-head:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: -3px;
  }

  .cq-etapa-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: none;
    border: 1px solid var(--sky-line);
    border-radius: 50%;
    background: #ffffff;
    color: var(--blue);
    font-size: 0.68rem;
    line-height: 1;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .cq-etapa.is-abierta .cq-etapa-chevron {
    transform: rotate(90deg);
    border-color: var(--blue);
    background: var(--blue);
    color: #ffffff;
  }

  .cq-etapa-nombre {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .cq-etapa-actual {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.5rem;
    border: 1px solid #ecdca0;
    border-radius: 999px;
    background: #fdf6dd;
    color: #6b5a13;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cq-etapa-meta {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .cq-etapa-preview {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.7rem 0.95rem 0.85rem;
  }

  .cq-etapa-preview[hidden] {
    display: none;
  }

  .cq-etapa-preview .cq-etapa-preview-foto {
    width: 84px;
    flex: none;
    border-radius: 9px;
  }

  .cq-etapa-ver {
    margin-left: auto;
    min-height: 36px;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--sky-line);
    border-radius: 999px;
    background: #ffffff;
    color: var(--blue);
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .cq-etapa-ver:hover {
    border-color: var(--blue);
    background: var(--sky);
  }

  .cq-etapa-panel {
    display: grid;
    gap: 1rem;
    padding: 1rem 0.95rem 1.1rem;
  }

  .cq-etapa-panel[hidden] {
    display: none;
  }

  .cq-avance {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--sky-line);
    border-radius: 12px;
    background: #ffffff;
  }

  .cq-etapa-panel .cq-avance {
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
  }

  .cq-etapa-panel .cq-avance + .cq-avance {
    padding-top: 1rem;
    border-top: 1px dashed var(--sky-line);
  }

  .cq-avance-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .cq-avance-fecha {
    color: var(--navy);
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .cq-avance-cuenta {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .cq-avance-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    min-width: 0;
  }

  .cq-avance-foto {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid #e2ecf8;
    border-radius: 11px;
    background: var(--sky);
    cursor: zoom-in;
  }

  .cq-avance-foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .cq-avance-foto:hover img {
    transform: scale(1.04);
  }

  .cq-avance-foto:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  .cq-avance-vacio {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (min-width: 560px) {
    .cq-avance-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cq-avance-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .cq-etapa-meta {
      width: 100%;
      margin-left: 1.6rem;
      text-align: left;
      white-space: normal;
    }

    .cq-etapa-preview .cq-etapa-preview-foto {
      width: 68px;
    }

    .cq-etapa-ver {
      margin-left: 0;
    }
  }

  .cq-avance-foto {
    background: linear-gradient(90deg, #eef4fb 25%, #dce9f7 37%, #eef4fb 63%);
    background-size: 400% 100%;
    animation: cqAvanceShimmer 1.4s ease-in-out infinite;
  }

  .cq-avance-foto img {
    opacity: 0;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .cq-avance-foto.is-lista {
    background: var(--sky);
    animation: none;
  }

  .cq-avance-foto.is-lista img {
    opacity: 1;
  }

  @keyframes cqAvanceShimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cq-etapa,
    .cq-avance-foto,
    .cq-avance-foto img,
    .cq-etapa-chevron,
    .cq-avances-accion,
    .cq-etapa-ver {
      animation: none;
      transition: none;
    }
  }
</style>
