---
/**
 * Visor de fotos a pantalla completa — diálogo con foco atrapado, cierre con
 * ✕ / Esc / deslizar hacia abajo, navegación con flechas y swipe, doble toque
 * para acercar. `consulta-client.ts` lo abre desde el carrusel y devuelve el
 * foco a la foto de origen al cerrar.
 */
---

<div class="cq-visor" id="cq-visor" role="dialog" aria-modal="true" aria-label="Visor de fotos" hidden>
  <div class="cq-visor-top">
    <span class="cq-visor-contador" data-campo="contador">1/1</span>
    <button class="cq-visor-boton-cerrar" type="button" data-accion="cerrar" aria-label="Cerrar visor (Esc)">
      <span aria-hidden="true">✕</span>
    </button>
  </div>

  <div class="cq-visor-escena">
    <button class="cq-visor-nav cq-visor-prev" type="button" data-accion="prev" aria-label="Foto anterior">
      <span aria-hidden="true">‹</span>
    </button>
    <img class="cq-visor-img" id="cq-visor-img" alt="" />
    <button class="cq-visor-nav cq-visor-next" type="button" data-accion="next" aria-label="Foto siguiente">
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <div class="cq-visor-acciones">
    <a class="btn btn-gold btn-sm" id="cq-visor-descargar" href="#" download>⬇ Descargar foto</a>
  </div>

  <p class="cq-visor-ayuda">Desliza para cambiar · doble toque para acercar · Esc para cerrar</p>
</div>

<style>
  .cq-visor {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(8, 24, 52, 0.98);
    overscroll-behavior: contain;
  }

  .cq-visor[hidden] {
    display: none;
  }

  /* El chrome flota encima: la foto usa TODA la pantalla */
  .cq-visor-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(0.7rem, 2vw, 1.1rem) clamp(0.8rem, 2.4vw, 1.4rem);
    background: linear-gradient(rgba(8, 24, 52, 0.9), rgba(8, 24, 52, 0));
    pointer-events: none;
  }

  .cq-visor-top > * {
    pointer-events: auto;
  }

  .cq-visor-contador {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .cq-visor-boton-cerrar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.32);
    background: rgba(8, 24, 52, 0.55);
    color: #ffffff;
    font-size: 1.1rem;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .cq-visor-boton-cerrar:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .cq-visor-escena {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* La imagen escala hasta llenar la pantalla (contener = sin recortar).
     Absoluta al escenario: como grid item con height:% algunos motores
     (WebKit en PC, con fotos EXIF-rotadas) la alinean al fondo en vez de
     centrarla; con inset:0 la caja es siempre el viewport completo. */
  .cq-visor-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.2s ease, opacity 0.2s ease;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: pan-y;
    opacity: 0;
    background: linear-gradient(90deg, #12294f 25%, #1b3a68 37%, #12294f 63%);
    background-size: 400% 100%;
    animation: cqVisorShimmer 1.4s ease-in-out infinite;
  }

  .cq-visor-img.is-lista {
    opacity: 1;
    background: transparent;
    animation: none;
  }

  @keyframes cqVisorShimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: 0 0;
    }
  }

  .cq-visor-img.is-zoom {
    transform: scale(2);
    cursor: zoom-out;
  }

  .cq-visor-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.32);
    background: rgba(8, 24, 52, 0.55);
    color: #ffffff;
    font-size: 1.6rem;
    line-height: 1;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .cq-visor-nav[disabled] {
    opacity: 0.25;
    cursor: default;
  }

  .cq-visor-prev {
    left: clamp(0.4rem, 2vw, 1.2rem);
  }

  .cq-visor-next {
    right: clamp(0.4rem, 2vw, 1.2rem);
  }

  .cq-visor-acciones {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(2.1rem, 5vh, 3rem);
    z-index: 3;
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
    padding: 0 1rem;
  }

  .cq-visor-ayuda {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(0.6rem, 2vh, 0.95rem);
    z-index: 3;
    text-align: center;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.66);
    padding: 0 1rem;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 640px) {
    .cq-visor-nav {
      display: none;
    }
  }
</style>
