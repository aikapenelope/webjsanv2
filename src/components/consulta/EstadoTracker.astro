---
/**
 * Tracker del estado de la OT — 7 pasos (0..6), horizontal en desktop y vertical
 * en móvil. `consulta-client.ts` marca `is-done` / `is-current`, muestra el
 * banner de imprevisto/cancelado y los chips de estado y días en taller.
 * Etapas: 0 Recibido · 1 En diagnóstico · 2 Por aprobar · 3 Aprobado ·
 *         4 En trabajo · 5 Listo · 6 Entregado · (-1 cancelado · -2 imprevisto)
 */
const PASOS = ['Recibido', 'En diagnóstico', 'Por aprobar', 'Aprobado', 'En trabajo', 'Listo', 'Entregado'];
---

<section class="cq-tracker" id="cq-tracker" hidden>
  <div class="cq-tracker-head">
    <div>
      <span class="kicker">Estado en el taller</span>
      <h3 class="cq-tracker-titulo">
        Orden de trabajo <span data-campo="nroOT">—</span>
      </h3>
    </div>
    <div class="cq-chips">
      <span class="cq-chip cq-chip-estado" data-campo="estado">—</span>
      <span class="cq-chip cq-chip-dias" data-campo="dias" hidden></span>
    </div>
  </div>

  <p class="cq-banner" id="cq-banner" role="note" hidden></p>

  <ol class="cq-pasos" id="cq-pasos">
    {PASOS.map((paso, i) => (
      <li data-paso={i}>
        <span class="cq-paso-circulo" aria-hidden="true">{i + 1}</span>
        <span class="cq-paso-texto">{paso}</span>
      </li>
    ))}
  </ol>

  <p class="cq-tracker-pie" data-campo="pie"></p>
</section>

<style>
  .cq-tracker {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: clamp(1.1rem, 2.4vw, 1.6rem);
  }

  .cq-tracker-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.2rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  .cq-tracker-titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    text-transform: uppercase;
    color: var(--navy);
    line-height: 1.1;
  }

  .cq-tracker-titulo [data-campo='nroOT'] {
    color: var(--blue);
  }

  .cq-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .cq-chip {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--sky-line);
    background: var(--sky);
    color: var(--navy);
    white-space: nowrap;
  }

  .cq-chip-estado {
    background: var(--navy);
    border-color: var(--navy);
    color: #ffffff;
  }

  .cq-chip-dias {
    background: #fffaf0;
    border-color: #ecd9a8;
    color: #7a5c06;
  }

  .cq-banner {
    margin-top: 1rem;
    background: #fff7e6;
    border: 1px solid #f0d9a0;
    border-left: 5px solid var(--gold);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: #6b4e05;
    line-height: 1.45;
  }

  .cq-banner.is-cancelado {
    background: #fdf1f0;
    border-color: #f0c4be;
    border-left-color: #c0392b;
    color: #8e2a1f;
  }

  .cq-pasos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.4rem;
    margin: 1.35rem 0 0.4rem;
    padding: 0;
  }

  .cq-pasos li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    text-align: center;
  }

  /* Conector entre pasos: segmento a la derecha de cada paso */
  .cq-pasos li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 17px;
    left: calc(50% + 22px);
    width: calc(100% - 44px);
    height: 3px;
    background: var(--sky-line);
    border-radius: 2px;
    z-index: 0;
  }

  .cq-pasos li.is-done:not(:last-child)::after {
    background: var(--blue);
  }

  .cq-paso-circulo {
    position: relative;
    z-index: 1;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    background: var(--sky);
    border: 1.5px solid var(--sky-line);
    color: var(--muted);
  }

  .cq-paso-texto {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    line-height: 1.25;
    max-width: 12ch;
  }

  .cq-pasos li.is-done .cq-paso-circulo {
    background: var(--blue);
    border-color: var(--blue);
    color: #ffffff;
  }

  .cq-pasos li.is-done .cq-paso-texto {
    color: var(--navy);
  }

  .cq-pasos li.is-current .cq-paso-circulo {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--navy-deep);
    box-shadow: 0 0 0 5px rgba(201, 162, 39, 0.22);
  }

  .cq-pasos li.is-current .cq-paso-texto {
    color: var(--navy);
    font-weight: 700;
  }

  .cq-pasos.is-detenido li .cq-paso-circulo {
    opacity: 0.55;
  }

  .cq-tracker-pie {
    font-size: 0.84rem;
    color: var(--muted);
    margin-top: 0.7rem;
  }

  @media (max-width: 780px) {
    .cq-pasos {
      grid-template-columns: 1fr;
      gap: 0.55rem;
      margin-top: 1.1rem;
    }

    .cq-pasos li {
      grid-template-columns: 36px 1fr;
      justify-items: start;
      align-items: center;
      text-align: left;
      gap: 0.75rem;
    }

    .cq-pasos li:not(:last-child)::after {
      top: calc(50% + 20px);
      left: 16.5px;
      width: 3px;
      height: calc(100% - 6px);
    }

    .cq-paso-texto {
      max-width: none;
      font-size: 0.86rem;
    }
  }
</style>
