---
/**
 * Tarjeta del vehículo — estructura estática; `consulta-client.ts` rellena los
 * `data-campo` y la muestra cuando el expediente existe.
 * El h2 es el punto de foco tras una consulta exitosa (lectores de pantalla).
 */
---

<section class="cq-vehiculo" id="cq-vehiculo" hidden>
  <div class="cq-placa-caja" aria-hidden="true">
    <span class="cq-placa-cinta"></span>
    <span class="cq-placa" data-campo="placa">—</span>
  </div>

  <div class="cq-vehiculo-datos">
    <h2 class="cq-vehiculo-titulo" id="cq-resultado-titulo" tabindex="-1" data-campo="titulo">
      Expediente del vehículo
    </h2>

    <dl class="cq-datos">
      <div data-dato="ano">
        <dt>Año</dt>
        <dd data-campo="ano">—</dd>
      </div>
      <div data-dato="color">
        <dt>Color</dt>
        <dd data-campo="color">—</dd>
      </div>
      <div data-dato="km">
        <dt>Último km</dt>
        <dd data-campo="km">—</dd>
      </div>
      <div data-dato="visitas">
        <dt>Visitas al taller</dt>
        <dd data-campo="visitas">—</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .cq-vehiculo {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: clamp(1.1rem, 2.4vw, 1.6rem);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 2.6vw, 1.8rem);
    align-items: center;
  }

  .cq-placa-caja {
    position: relative;
    background: var(--navy-deep);
    border: 2px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    padding: 0.7rem 1.15rem 0.55rem;
    box-shadow: inset 0 -6px 0 rgba(0, 0, 0, 0.25);
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    min-width: 168px;
  }

  .cq-placa-cinta {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: var(--gold);
    border-radius: 10px 10px 0 0;
  }

  .cq-placa {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    letter-spacing: 0.16em;
    color: #ffffff;
    line-height: 1.1;
  }

  .cq-vehiculo-titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--navy);
    text-wrap: balance;
  }

  .cq-datos {
    margin-top: 0.9rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem 1.2rem;
  }

  .cq-datos dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.1rem;
  }

  .cq-datos dd {
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
  }

  @media (max-width: 620px) {
    .cq-vehiculo {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .cq-vehiculo-datos {
      width: 100%;
    }

    .cq-datos {
      text-align: left;
    }
  }
</style>
