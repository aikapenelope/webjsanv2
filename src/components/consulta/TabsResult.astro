---
/**
 * Tabs del resultado: Recepción · Informe X431 · Historial · Garantía.
 * Patrón de tabs con ARIA (tablist/tab/tabpanel, roving tabindex y teclado)
 * controlado desde `consulta-client.ts`. La pestaña X431 carga el informe en
 * diferido la primera vez que se abre.
 */
import CarruselFotos from './CarruselFotos.astro';
import AvisoVideo from './AvisoVideo.astro';
import InformeX431 from './InformeX431.astro';
import HistorialVisitas from './HistorialVisitas.astro';
import GarantiaSenal from './GarantiaSenal.astro';
---

<div class="cq-tabs" id="cq-tabs">
  <div class="cq-tablist" role="tablist" aria-label="Secciones del expediente">
    <button class="cq-tab is-activo" type="button" role="tab" id="cq-tab-recepcion" aria-controls="cq-panel-recepcion" aria-selected="true" tabindex="0">
      <span aria-hidden="true">📥</span> Recepción
    </button>
    <button class="cq-tab" type="button" role="tab" id="cq-tab-x431" aria-controls="cq-panel-x431" aria-selected="false" tabindex="-1">
      <span aria-hidden="true">🔍</span> Informe X431
    </button>
    <button class="cq-tab" type="button" role="tab" id="cq-tab-historial" aria-controls="cq-panel-historial" aria-selected="false" tabindex="-1">
      <span aria-hidden="true">🗂️</span> Historial
    </button>
    <button class="cq-tab" type="button" role="tab" id="cq-tab-garantia" aria-controls="cq-panel-garantia" aria-selected="false" tabindex="-1">
      <span aria-hidden="true">🛡️</span> Garantía
    </button>
  </div>

  <div class="cq-panel is-activo" role="tabpanel" id="cq-panel-recepcion" aria-labelledby="cq-tab-recepcion" tabindex="0">
    <div class="cq-ficha" id="cq-recep-ficha" hidden>
      <dl class="cq-ficha-datos">
        <div><dt>N.º de entrada</dt><dd data-campo="nroEntrada">—</dd></div>
        <div><dt>Fecha</dt><dd data-campo="fecha">—</dd></div>
        <div><dt>Km reportado</dt><dd data-campo="km">—</dd></div>
      </dl>
      <p class="cq-ficha-sintoma" data-campo="sintoma" hidden></p>
    </div>

    <p class="cq-nota-vacia" id="cq-recep-vacio" hidden>
      Aún no hay una recepción registrada para este vehículo. Si acabas de dejarlo en el taller,
      aparecerá aquí en cuanto el equipo complete el ingreso.
    </p>

    <CarruselFotos />
    <AvisoVideo />
  </div>

  <div class="cq-panel" role="tabpanel" id="cq-panel-x431" aria-labelledby="cq-tab-x431" tabindex="0" hidden>
    <InformeX431 />
  </div>

  <div class="cq-panel" role="tabpanel" id="cq-panel-historial" aria-labelledby="cq-tab-historial" tabindex="0" hidden>
    <HistorialVisitas />
  </div>

  <div class="cq-panel" role="tabpanel" id="cq-panel-garantia" aria-labelledby="cq-tab-garantia" tabindex="0" hidden>
    <GarantiaSenal />
  </div>

  <footer class="cq-result-pie">
    <span class="cq-actualizado" data-campo="actualizado">—</span>
    <button class="btn btn-ghost btn-sm" type="button" id="cq-refrescar">Actualizar ↻</button>
  </footer>
</div>

<style>
  .cq-tabs {
    display: grid;
    gap: 1rem;
  }

  .cq-tablist {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--sky-line);
  }

  .cq-tablist::-webkit-scrollbar {
    display: none;
  }

  .cq-tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.55rem 1rem;
    border: 1px solid transparent;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    border-radius: 10px 10px 0 0;
  }

  .cq-tab:hover {
    color: var(--navy);
    background: var(--sky);
  }

  .cq-tab.is-activo {
    color: var(--navy);
    border-bottom-color: var(--gold);
    background: var(--sky);
  }

  .cq-panel {
    display: grid;
    gap: 1rem;
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: clamp(1rem, 2.4vw, 1.5rem);
  }

  .cq-panel[hidden] {
    display: none;
  }

  .cq-ficha-datos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.85rem 1.2rem;
    background: var(--sky);
    border: 1px solid var(--sky-line);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
  }

  .cq-ficha-datos dt {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.15rem;
  }

  .cq-ficha-datos dd {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
  }

  .cq-ficha-sintoma {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    color: var(--navy);
    line-height: 1.5;
    border-left: 3px solid var(--gold);
    padding-left: 0.85rem;
    text-wrap: pretty;
  }

  .cq-nota-vacia {
    font-size: 0.95rem;
    color: var(--muted);
    background: var(--sky);
    border: 1px solid var(--sky-line);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1rem;
    line-height: 1.5;
  }

  .cq-result-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    padding-top: 0.4rem;
  }

  .cq-actualizado {
    font-size: 0.84rem;
    color: var(--muted);
  }

  @media (max-width: 520px) {
    .cq-result-pie .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
