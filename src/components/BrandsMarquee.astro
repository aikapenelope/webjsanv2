---
import { MARCAS } from '../data/site';

// Carga eagerly todos los SVGs para inyectarlos en línea y permitir transiciones CSS nativas
const marcasSvg = import.meta.glob('../assets/marcas/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

/**
 * Cada escudo se emite UNA sola vez como <symbol> y el carrusel lo referencia con
 * <use>. Antes el HTML repetía los 16 SVG completos (dos copias para el bucle
 * infinito): eran ~59 KB de paths duplicados en la portada.
 */
const escudos = MARCAS.map((marca) => {
  const raw = marcasSvg[`../assets/marcas/${marca}.svg`] ?? '';
  const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 24 24';
  const contenido = raw
    .replace(/<\?xml[\s\S]*?\?>/g, '')
    .replace(/<svg[^>]*>/i, '')
    .replace(/<\/svg>\s*$/i, '')
    .trim();

  return { marca, id: `escudo-${marca}`, viewBox, contenido };
});

const idPorMarca = new Map(escudos.map((e) => [e.marca, e.id]));
---

<section id="marcas" class="marcas-sec">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Compatibilidad multimarca</span>
      <h2 class="sec-title">Atendemos las marcas líderes del mercado</h2>
      <p class="sec-lead">Dominamos las transmisiones automáticas, CVT y secuenciales de fabricantes americanos, asiáticos y europeos.</p>
    </div>
  </div>

  <!-- SPRITE ÚNICO: los 16 escudos se definen una vez y se reutilizan con <use> -->
  <svg class="mq-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    {escudos.map((e) => (
      <symbol id={e.id} viewBox={e.viewBox} set:html={e.contenido}></symbol>
    ))}
  </svg>

  <div class="marquee-wrap" aria-label="Carrusel de marcas atendidas">
    <div class="marquee-track">
      {[0, 1].map((copia) =>
        MARCAS.map((m) => (
          <div class="mq-item" title={`Especialistas en ${m}`} aria-hidden={copia === 1 ? 'true' : undefined}>
            <span class="mq-icon" aria-hidden="true">
              <svg focusable="false">
                <use href={`#${idPorMarca.get(m)}`}></use>
              </svg>
            </span>
            <span class="mq-label">{m}</span>
          </div>
        )) 
      )}
    </div>
  </div>
</section>

<style>
  .marcas-sec {
    padding: clamp(2.4rem, 4.5vw, 3.4rem) 0 0;
    background: #ffffff;
    border-top: 1px solid var(--sky-line);
  }

  /* Sprite de escudos: no genera caja ni se anuncia (solo define los <symbol>) */
  .mq-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .marquee-wrap {
    overflow: hidden;
    padding: 1.35rem 0;
    border-top: 1px solid var(--sky-line);
    border-bottom: 1px solid var(--sky-line);
    background: var(--sky);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 3.4rem;
    width: max-content;
    animation: mq 38s linear infinite;
    will-change: transform;
    transform: translateZ(0);
  }

  .marquee-wrap:hover .marquee-track {
    animation-play-state: paused;
  }

  .mq-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #94a1be;
    text-decoration: none;
    flex: none;
    transition: color 0.15s ease;
  }

  .mq-item:hover {
    color: var(--blue);
  }

  .mq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mq-icon :global(svg) {
    width: 36px;
    height: 36px;
    fill: currentColor;
  }

  .mq-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .mq-item:hover .mq-label {
    color: var(--blue);
  }

  @media (max-width: 768px) {
    .marquee-track {
      gap: 2.2rem;
    }
    .mq-icon :global(svg) {
      width: 28px;
      height: 28px;
    }
    .mq-label {
      font-size: 1.1rem;
    }
  }
</style>
