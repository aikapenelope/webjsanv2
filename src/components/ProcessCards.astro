---
const PASOS = [
  {
    n: '01',
    t: 'Traes el carro',
    tag: 'Recepción & Síntomas',
    p: 'Nos cuentas qué sentiste: patineo, golpe en cambio o luz de tablero encendida. Anotamos el historial completo.',
  },
  {
    n: '02',
    t: 'Escaneamos',
    tag: 'Scanner Computarizado',
    p: 'Lectura de códigos DTC con scanner de última generación + revisión hidráulica y de fluido por el especialista.',
  },
  {
    n: '03',
    t: 'Apruebas',
    tag: 'Cotización por WhatsApp',
    p: 'Presupuesto claro con desglose exacto de repuestos y mano de obra. Nada se inicia sin tu visto bueno.',
  },
  {
    n: '04',
    t: 'Entregamos',
    tag: 'Prueba & Garantía',
    p: 'Reparación con repuestos originales importados, prueba de manejo y certificado de garantía por escrito.',
  },
];
---

<section id="proceso" class="process-sec section section-navy">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker kicker-gold">Metodología de Trabajo</span>
      <h2 class="sec-title sec-title-light">Diagnóstico claro, sin sorpresas en la cuenta</h2>
      <p class="sec-lead sec-lead-light">4 pasos transparentes desde que entras por nuestro portón en Monte Cristo hasta que sales con tu transmisión en garantía.</p>
    </div>

    <div class="steps-grid">
      {PASOS.map((paso) => (
        <article class="step-card">
          <span class="step-num">{paso.n}</span>
          <div class="step-body">
            <span class="step-tag">{paso.tag}</span>
            <h3>{paso.t}</h3>
            <p>{paso.p}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    counter-reset: step;
  }

  .step-card {
    background: var(--navy-panel);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    padding: 1.6rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    position: relative;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .step-card:hover {
    background: rgba(33, 75, 148, 0.55);
    border-color: rgba(233, 194, 92, 0.4);
    transform: translateY(-2px);
  }

  /* Conector de proceso entre pasos */
  .step-card:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -0.85rem;
    width: 0.7rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.55;
    z-index: 1;
  }

  .step-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(233, 194, 92, 0.55);
    letter-spacing: 0.02em;
  }

  .step-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .step-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  .step-card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.45rem;
    text-transform: uppercase;
    color: #ffffff;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .step-card p {
    font-size: 0.9rem;
    color: var(--muted-dark);
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (max-width: 990px) {
    .steps-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }

    .step-card:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }

    .step-card {
      padding: 1.4rem 1.2rem;
    }
  }
</style>