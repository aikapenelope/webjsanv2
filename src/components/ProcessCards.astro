---
const PASOS = [
  {
    n: '01',
    t: 'Traes el carro',
    tag: 'Recepción & Síntomas',
    p: 'Nos cuentas qué sentiste: patineo, golpe en cambio o luz de tablero encendida. Anotamos el historial completo.',
  },
  {
    n: '02',
    t: 'Escaneamos',
    tag: 'Scanner Computarizado',
    p: 'Lectura de códigos DTC con scanner de última generación + revisión hidráulica y de fluido por el especialista.',
  },
  {
    n: '03',
    t: 'Apruebas',
    tag: 'Cotización por WhatsApp',
    p: 'Presupuesto claro con desglose exacto de repuestos y mano de obra. Nada se inicia sin tu visto bueno.',
  },
  {
    n: '04',
    t: 'Entregamos',
    tag: 'Prueba & Garantía',
    p: 'Reparación con repuestos originales importados, prueba de manejo y certificado de garantía por escrito.',
  },
];
---

<section id="proceso" class="process-sec">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker kicker-gold">Metodología de Trabajo</span>
      <h2>Diagnóstico claro, sin sorpresas en la cuenta</h2>
      <p>4 pasos transparentes desde que entras por nuestro portón en Monte Cristo hasta que sales con tu transmisión en garantía.</p>
    </div>

    <div class="steps-grid">
      {PASOS.map((paso) => (
        <article class="step-card">
          <div class="step-header">
            <span class="step-num">PASO {paso.n}</span>
            <span class="step-tag">{paso.tag}</span>
          </div>
          <h3>{paso.t}</h3>
          <p>{paso.p}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .process-sec {
    padding: 4.8rem 0;
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: #ffffff;
    border-top: 1px solid var(--navy-deep);
  }

  .sec-head {
    max-width: 48rem;
    margin-bottom: 2.8rem;
  }

  .kicker-gold {
    color: var(--gold-soft);
  }

  .kicker-gold::before {
    background: var(--gold);
  }

  h2 {
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.4vw, 3.2rem);
    line-height: 1.02;
    text-transform: uppercase;
  }

  .sec-head p {
    color: var(--muted-dark);
    margin-top: 0.8rem;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }

  .step-card {
    background: var(--navy-panel);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 1.8rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .step-card:hover {
    transform: translateY(-4px);
    background: rgba(33, 75, 148, 0.8);
    border-color: var(--gold-soft);
  }

  .step-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
    flex-wrap: wrap;
  }

  .step-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.14em;
    color: var(--gold);
    text-transform: uppercase;
  }

  .step-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cad8f3;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.18rem 0.5rem;
    border-radius: 4px;
  }

  .step-card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }

  .step-card p {
    font-size: 0.92rem;
    color: var(--muted-dark);
    line-height: 1.5;
    flex: 1;
  }

  @media (max-width: 990px) {
    .steps-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
  }

  @media (max-width: 560px) {
    .process-sec {
      padding: 3.4rem 0;
    }

    .steps-grid {
      grid-template-columns: 1fr;
    }

    .step-card {
      padding: 1.5rem 1.3rem;
    }
  }
</style>
