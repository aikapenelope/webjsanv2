---
import { waLink } from '../data/site';

const SERVICIOS = [
  {
    num: '01',
    titulo: 'Diagnóstico & Scanner',
    subtitulo: 'Detección exacta sin desarmar a ciegas',
    desc: 'Escaneo computarizado DTC de motor y transmisión (TCM), prueba de presión hidráulica y prueba de manejo diagnóstica.',
    pills: ['Scanner DTC OBD-II', 'Módulos TCM & Sensores', 'Prueba de Presiones'],
    items: [
      'Lectura e interpretación de códigos de falla en vivo.',
      'Chequeo de solenoides, cableados y sensores de velocidad.',
      'Prueba de ruta con el técnico especialista a bordo.',
      'Presupuesto escrito y detallado antes de iniciar cualquier labor.',
    ],
    waMsg: 'Hola J-SAN, quiero solicitar un diagnóstico con scanner para mi carro:',
    ctaText: 'Agendar diagnóstico previo →',
  },
  {
    num: '02',
    titulo: 'Reparación & Reconstrucción',
    subtitulo: 'Overhaul completo con repuestos originales de EE.UU.',
    desc: 'Desarme completo, reemplazo de discos de fricción, bandas, sellos viton, turbina (convertidor) y cuerpo de válvulas calibrado.',
    pills: ['Kit Master Americano', 'Turbina Balanceada', 'Garantía 6 Meses'],
    items: [
      'Overhaul con kit master (discos, sellos, anillos y empacaduras).',
      'Reparación, prueba en banco y calibración de cuerpo de válvulas.',
      'Apertura, mantenimiento y balanceo dinámico del convertidor de par.',
      'Sustitución de tambores, planetarios y bombas de aceite fatigadas.',
    ],
    waMsg: 'Hola J-SAN, quiero cotizar la reparación/reconstrucción de mi caja automática:',
    ctaText: 'Cotizar reconstrucción de caja →',
  },
  {
    num: '03',
    titulo: 'Mantenimiento & Servicio ATF',
    subtitulo: 'La vida útil de tu caja automática',
    desc: 'Sustitución de fluido ATF según especificación estricta del fabricante (Dexron, Mercon, WS, CVT, DSG), filtro nuevo e inspección de cárter.',
    pills: ['Fluido ATF Certificado', 'Filtro + Empacadura', 'Prevención Térmica'],
    items: [
      'Drenado e inspección de sedimentos e impurezas en el cárter.',
      'Reemplazo de filtro de transmisión y empacadura sellante.',
      'Llenado con fluido específico para cajas automáticas, CVT o DSG.',
      'Servicio preventivo para motores y mecánica automotriz ligera.',
    ],
    waMsg: 'Hola J-SAN, quiero consultar por el servicio de cambio de aceite y filtro ATF:',
    ctaText: 'Consultar mantenimiento ATF →',
  },
  {
    num: '04',
    titulo: 'Repuestos & Importación',
    subtitulo: 'Componentes líderes de la industria americana',
    desc: 'Instalamos componentes de las marcas más prestigiosas de Estados Unidos: Sonnax, TransGo, Transtec y Precision International.',
    pills: ['Sonnax® & TransGo®', 'Cajas Listas para Montar', 'Importación Directa'],
    items: [
      'Venta e instalación de solenoides y kits correctores de válvulas.',
      'Importación directa de transmisiones usadas seleccionadas y nuevas.',
      'Búsqueda de piezas difíciles para modelos descontinuados.',
      'Garantía formal por escrito en repuestos y mano de obra.',
    ],
    waMsg: 'Hola J-SAN, estoy buscando un repuesto o caja importada para mi vehículo:',
    ctaText: 'Consultar repuestos disponibles →',
  },
];
---

<section id="servicios" class="services-sec">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Especialización Mecánica</span>
      <h2>Todo lo que necesita tu transmisión, en un solo taller</h2>
      <p>Del escaneo electrónico computarizado a la reconstrucción integral con piezas americanas. Siempre con presupuesto claro antes de tocar tu carro.</p>
    </div>

    <!-- CARDS MODERNAS CON UX MEJORADA -->
    <div class="svc-cards-grid">
      {SERVICIOS.map((s) => (
        <article class="svc-premium-card">
          <div class="card-top-bar">
            <span class="card-num">{s.num}</span>
            <div class="card-pills">
              {s.pills.map((pill) => (
                <span class="card-pill">{pill}</span>
              ))}
            </div>
          </div>

          <div class="card-body">
            <h3>{s.titulo}</h3>
            <p class="card-sub">{s.subtitulo}</p>
            <p class="card-desc">{s.desc}</p>

            <div class="card-checklist">
              <span class="checklist-title">Qué incluye:</span>
              <ul>
                {s.items.map((item) => (
                  <li>
                    <span class="check-ico" aria-hidden="true">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="card-footer">
            <a
              class="btn btn-primary btn-sm btn-svc-cta"
              href={waLink(s.waMsg)}
              target="_blank"
              rel="noopener"
            >
              <span>{s.ctaText}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-sec {
    padding: 4.6rem 0 5rem;
    background: linear-gradient(180deg, #ffffff 0%, var(--sky) 140%);
    border-bottom: 1px solid var(--sky-line);
  }

  .sec-head {
    max-width: 48rem;
    margin-bottom: 2.8rem;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4.4vw, 3.3rem);
    line-height: 1.02;
    text-transform: uppercase;
    color: var(--navy);
    text-wrap: balance;
  }

  .sec-head p {
    color: var(--muted);
    margin-top: 0.9rem;
    font-size: 1.08rem;
    line-height: 1.6;
  }

  /* GRID DE CARDS PREMIUM */
  .svc-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.8rem;
  }

  .svc-premium-card {
    background: #ffffff;
    border: 1.5px solid var(--sky-line);
    border-top: 4px solid var(--blue);
    border-radius: var(--radius);
    padding: 2.2rem 2rem 1.8rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 28px rgba(15, 42, 87, 0.05);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .svc-premium-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 42px rgba(15, 42, 87, 0.12);
    border-color: var(--blue);
    border-top-color: var(--gold);
  }

  .card-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }

  .card-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--gold);
    line-height: 1;
    background: rgba(201, 162, 39, 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: 8px;
  }

  .card-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .card-pill {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
    background: var(--blue-soft);
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(45, 88, 147, 0.15);
  }

  .card-body {
    flex: 1;
  }

  .card-body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.35rem;
  }

  .card-sub {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 0.8rem;
  }

  .card-desc {
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.55;
    margin-bottom: 1.4rem;
  }

  .card-checklist {
    background: var(--sky);
    border: 1px solid var(--sky-line);
    border-radius: 12px;
    padding: 1.2rem 1.3rem;
    margin-bottom: 1.6rem;
  }

  .checklist-title {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }

  .card-checklist ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-checklist li {
    font-size: 0.9rem;
    color: var(--navy);
    line-height: 1.45;
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .check-ico {
    color: var(--green);
    font-weight: 900;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .card-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--sky-line);
  }

  .btn-svc-cta {
    width: 100%;
    justify-content: center;
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .svc-cards-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .services-sec {
      padding: 3.2rem 0;
    }

    .svc-premium-card {
      padding: 1.6rem 1.3rem;
    }

    .card-body h3 {
      font-size: 1.5rem;
    }

    .card-checklist {
      padding: 1rem;
    }
  }
</style>
