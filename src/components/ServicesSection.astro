    titulo: 'Repuestos & Importación',
    subtitulo: 'Componentes líderes de la industria americana',
    desc: 'Instalamos componentes de las marcas más prestigiosas de Estados Unidos: Sonnax, TransGo, Transtec y Precision International.',
    pills: ['Sonnax® & TransGo®', 'Piezas Certificadas', 'Importación Directa'],
    items: [
