---
import { waLink } from '../data/site';

interface SintomaTecnico {
  id: string;
  codigo: string;
  nombre: string;
  subtitulo: string;
  sintomatologia: string;
  causaMecanica: string;
  componentes: string[];
  nivelSeveridad: 'Atención Prioritaria' | 'Evaluación Inmediata' | 'Mantenimiento Requerido';
  protocoloTaller: string;
  waMsg: string;
}

const SINTOMAS: SintomaTecnico[] = [
  {
    id: 'patinaje',
    codigo: 'S-01',
    nombre: 'Pérdida de Tracción / Patinaje',
    subtitulo: 'Incremento de RPM del motor sin respuesta proporcional en la marcha',
    sintomatologia: 'Al pisar el acelerador, las revoluciones del motor aumentan pero el vehículo acelera de forma deficiente o resbala en cambios altos.',
    causaMecanica: 'Desgaste severo en el material de fricción de los embragues (clutches), pérdida de presión en el circuito hidráulico o fluido ATF degradado.',
    componentes: ['Kit Master de Discos', 'Sellos de Pistón Viton', 'Bomba de Aceite Principal'],
    nivelSeveridad: 'Atención Prioritaria',
    protocoloTaller: 'Prueba de estanqueidad y lectura de presiones de línea antes de determinar si requiere overhaul o reemplazo parcial.',
    waMsg: 'Hola J-SAN, mi vehículo presenta pérdida de tracción y patinaje en la transmisión. Deseo agendar diagnóstico.',
  },
  {
    id: 'golpe-acople',
    codigo: 'S-02',
    nombre: 'Impacto Hidráulico al Acoplar',
    subtitulo: 'Golpe seco o vibración brusca al pasar de Neutral a Drive o Retroceso',
    sintomatologia: 'Al mover la palanca de cambios se percibe un tirón seco que sacude la carrocería, o cambios bruscos entre 1ra y 2da marcha.',
    causaMecanica: 'Válvula reguladora de presión trabada, solenoide modulador defectuoso, o desgaste en las galerías de aluminio del cuerpo de válvulas.',
    componentes: ['Cuerpo de Válvulas', 'Solenoides EPC/TCC', 'Placa Separadora'],
    nivelSeveridad: 'Atención Prioritaria',
    protocoloTaller: 'Escaneo computarizado de parámetros de presión y prueba en banco hidráulico del cuerpo de válvulas para calibración con repuestos Sonnax®.',
    waMsg: 'Hola J-SAN, mi carro presenta golpe al acoplar Drive/Retroceso. Deseo cotizar revisión de cuerpo de válvulas.',
  },
  {
    id: 'fuga-fluido',
    codigo: 'S-03',
    nombre: 'Pérdida Visible de Fluido ATF',
    subtitulo: 'Manchas de aceite rojizo o marrón en la parte inferior del motor o transmisión',
    sintomatologia: 'Presencia de goteo de fluido rojizo en el piso, olor a aceite recalentado o nivel descendente en la varilla de medición.',
    causaMecanica: 'Falla en la estopera delantera de la bomba de aceite, sellos desgastados en el cuello del convertidor de par o empacadura de cárter fatigada.',
    componentes: ['Estopera de Convertidor', 'Empacadura Sellante', 'Retenes de Semieje'],
    nivelSeveridad: 'Evaluación Inmediata',
    protocoloTaller: 'Inspección visual en elevador para identificar el punto exacto de fuga y reemplazo de retenes para evitar daño mayor por falta de lubricación.',
    waMsg: 'Hola J-SAN, tengo una fuga de aceite de transmisión en mi carro. Deseo coordinar revisión en el taller.',
  },
  {
    id: 'retardo-frio',
    codigo: 'S-04',
    nombre: 'Retardo de Acople en Frío',
    subtitulo: 'Demora prolongada en la aplicación de la velocidad durante el primer encendido',
    sintomatologia: 'Al encender el vehículo por la mañana, la velocidad tarda entre 15 y 45 segundos en engranar hasta que el motor alcanza temperatura.',
    causaMecanica: 'Endurecimiento térmico de los sellos de goma de los pistones internos, perdiendo elasticidad para retener la presión hidráulica inicial.',
    componentes: ['Sellos de Pistón', 'Filtro Colador ATF', 'Anillos de Sellado'],
    nivelSeveridad: 'Mantenimiento Requerido',
    protocoloTaller: 'Verificación del estado químico del fluido ATF y evaluación de respuesta hidráulica para determinar si un servicio preventivo corrige la condición.',
    waMsg: 'Hola J-SAN, mi vehículo tarda en aplicar la velocidad cuando está frío en las mañanas. Deseo consultar evaluación.',
  },
  {
    id: 'modo-emergencia',
    codigo: 'S-05',
    nombre: 'Bloqueo Electrónico / Modo Falla',
    subtitulo: 'Testigo de transmisión o Check Engine encendido y caja bloqueada en 3ra marcha',
    sintomatologia: 'La computadora del vehículo entra en modo de protección (limp home mode), fijando una marcha para evitar sobrecargas mecánicas.',
    causaMecanica: 'Falla de comunicación en la red CAN bus, sensor de velocidad de entrada/salida dañado o anomalía en el módulo de control TCM.',
    componentes: ['Módulo TCM', 'Sensor de Entrada/Salida', 'Mazo de Cables'],
    nivelSeveridad: 'Evaluación Inmediata',
    protocoloTaller: 'Conexión de scanner de diagnóstico para extracción de códigos DTC específicos y prueba de continuidad en el sistema eléctrico.',
    waMsg: 'Hola J-SAN, mi carro tiene la luz de Check Engine/Transmisión encendida y está bloqueado en una marcha. Deseo escaneo.',
  },
];
---

<section id="diagnostico-guiado" class="diag-sec section section-white">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Diagnóstico Técnico Especializado</span>
      <h2 class="sec-title">Evaluación de Síntomas &amp; Causas Mecánicas</h2>
      <p class="sec-lead">Selecciona el comportamiento anómalo que presenta tu vehículo para conocer el diagnóstico técnico preliminar y los componentes comprometidos.</p>
    </div>

    <div class="diag-container">
      <!-- SELECTOR LATERAL DE SÍNTOMAS (ESTILO EDITORIAL SOBRIO) -->
      <div class="diag-tabs" role="tablist" aria-label="Síntomas mecánicos de transmisión">
        {SINTOMAS.map((s, idx) => (
          <button
            class:list={['diag-tab-btn', idx === 0 && 'active']}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`diag-panel-${s.id}`}
            id={`diag-tab-${s.id}`}
            data-target={s.id}
          >
            <span class="tab-code">{s.codigo}</span>
            <div class="tab-info">
              <span class="tab-name">{s.nombre}</span>
              <span class="tab-sub">{s.subtitulo}</span>
            </div>
            <span class="tab-arrow" aria-hidden="true">→</span>
          </button>
        ))}
      </div>

      <!-- PANEL DE INFORMACIÓN TÉCNICA -->
      <div class="diag-display">
        {SINTOMAS.map((s, idx) => (
          <div
            class:list={['diag-panel', idx === 0 && 'active']}
            id={`diag-panel-${s.id}`}
            role="tabpanel"
            aria-labelledby={`diag-tab-${s.id}`}
          >
            <div class="panel-header">
              <div class="panel-meta">
                <span class="panel-code">{s.codigo}</span>
                <span class="panel-tag">ANÁLISIS DE FALLA</span>
              </div>
              <span class="panel-severity" data-severidad={s.nivelSeveridad}>
                {s.nivelSeveridad}
              </span>
            </div>

            <h3 class="panel-title">{s.nombre}</h3>
            <p class="panel-sintoma">{s.sintomatologia}</p>

            <div class="panel-box-cause">
              <span class="box-label">Causa Mecánica Principal</span>
              <p>{s.causaMecanica}</p>
            </div>

            <div class="panel-components">
              <span class="comp-label">Componentes del sistema involucrados:</span>
              <div class="comp-pills">
                {s.componentes.map((c) => (
                  <span class="comp-pill">{c}</span>
                ))}
              </div>
            </div>

            <div class="panel-protocol">
              <span class="protocol-label">Protocolo de Revisión J-SAN:</span>
              <p>{s.protocoloTaller}</p>
            </div>

            <div class="panel-action">
              <a
                class="btn btn-primary btn-diag-cta"
                href={waLink(s.waMsg)}
                target="_blank"
                rel="noopener"
              >
                <span>Consultar este síntoma con el especialista por WhatsApp →</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .diag-sec {
    background: #ffffff;
  }

  .diag-container {
    display: grid;
    grid-template-columns: 1.15fr 1.35fr;
    gap: 2rem;
    align-items: stretch;
  }

  .diag-tabs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .diag-display {
    min-width: 0;
  }

  .diag-tab-btn {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    padding: 1.05rem 1.2rem;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    transition: all 0.2s ease;
    font-family: var(--font-body);
  }

  .diag-tab-btn:hover {
    border-color: var(--blue);
    box-shadow: var(--shadow-card);
  }

  .diag-tab-btn.active {
    border-color: var(--blue);
    border-left: 3px solid var(--gold);
    box-shadow: var(--shadow-card);
  }

  .tab-code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--gold);
    background: rgba(201, 162, 39, 0.14);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    line-height: 1;
    flex-shrink: 0;
  }

  .tab-info {
    flex: 1;
    min-width: 0;
  }

  .tab-name {
    display: block;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.25;
  }

  .diag-tab-btn.active .tab-name {
    color: var(--blue);
  }

  .tab-sub {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.35;
    margin-top: 0.2rem;
  }

  .tab-arrow {
    color: var(--blue);
    font-weight: 900;
    font-size: 1.1rem;
    opacity: 0.3;
    transition: opacity 0.15s ease, transform 0.15s ease;
    flex-shrink: 0;
  }

  .diag-tab-btn.active .tab-arrow,
  .diag-tab-btn:hover .tab-arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  /* PANEL */
  .diag-display {
    background: var(--sky);
    border: 1px solid var(--sky-line);
    border-radius: 20px;
    padding: 2.4rem 2.4rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .diag-display::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--gold) 0%, rgba(201, 162, 39, 0.35) 22%, transparent 55%);
    opacity: 0.6;
    pointer-events: none;
  }

  .diag-panel {
    display: none;
    flex-direction: column;
    height: 100%;
  }

  .diag-panel.active {
    display: flex;
    animation: fadeInDiag 0.25s ease forwards;
  }

  @keyframes fadeInDiag {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--sky-line);
    flex-wrap: wrap;
  }

  .panel-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .panel-code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    color: var(--gold);
    background: var(--navy);
    padding: 0.22rem 0.6rem;
    border-radius: 4px;
  }

  .panel-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .panel-severity {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgba(45, 88, 147, 0.12);
    color: var(--blue);
  }

  .panel-severity[data-severidad="Evaluación Inmediata"] {
    background: rgba(185, 28, 28, 0.12);
    color: #b91c1c;
  }

  .panel-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.12;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }

  .panel-sintoma {
    font-size: 0.96rem;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 1.3rem;
  }

  .panel-box-cause {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius-sm);
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.3rem;
  }

  .box-label {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.35rem;
  }

  .panel-box-cause p {
    font-size: 0.94rem;
    color: var(--navy);
    font-weight: 600;
    line-height: 1.45;
  }

  .panel-components {
    margin-bottom: 1.3rem;
  }

  .comp-label {
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 600;
    display: block;
    margin-bottom: 0.45rem;
  }

  .comp-pills {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .comp-pill {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--navy);
    background: #ffffff;
    border: 1px solid var(--sky-line);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }

  .panel-protocol {
    background: #ffffff;
    border: 1px solid var(--sky-line);
    border-radius: var(--radius-sm);
    padding: 1rem 1.2rem;
    margin-bottom: 1.6rem;
  }

  .protocol-label {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.3rem;
  }

  .panel-protocol p {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.45;
  }

  .panel-action {
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .btn-diag-cta {
    width: 100%;
    justify-content: center;
    font-size: 0.92rem;
    padding: 0.85rem 1.2rem;
  }

  @media (max-width: 960px) {
    .diag-container {
      grid-template-columns: 1fr;
    }
    .diag-display {
      padding: 1.8rem 1.4rem;
    }
  }

  @media (max-width: 480px) {
    .diag-sec {
      padding: 3rem 0;
    }
    .diag-tab-btn {
      padding: 0.8rem 0.9rem;
      gap: 0.7rem;
    }
    .tab-code {
      font-size: 0.9rem;
      padding: 0.2rem 0.5rem;
    }
    .tab-name {
      font-size: 0.88rem;
    }
    .tab-sub {
      font-size: 0.72rem;
    }
    .panel-title {
      font-size: 1.4rem;
    }
    .diag-display {
      padding: 1.5rem 1.1rem;
    }
  }
</style>

<script>
  function setupDiagTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.diag-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.diag-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target');
        if (!targetId) return;

        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });

        panels.forEach((p) => {
          p.classList.remove('active');
        });

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const activePanel = document.getElementById(`diag-panel-${targetId}`);
        if (activePanel) {
          activePanel.classList.add('active');
        }
      });
    });
  }

  setupDiagTabs();
  document.addEventListener('astro:page-load', setupDiagTabs);
</script>
