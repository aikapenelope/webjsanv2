---
// Topbar sticky para páginas internas — con hamburguesa en móvil (menú global del layout)
interface Props {
  tagline?: string;
}
const { tagline = 'Taller Familiar · Est. 2013' } = Astro.props;
import { waLink } from '../data/site';
---

<div class="topbar2">
  <a class="tb-brand" href="/" aria-label="Inicio Hidromáticos J-SAN">
    <img src="/assets/logo-jsan.webp" alt="Escudo J-SAN" width="40" height="40" />
    <span>
      <b>HIDROMÁTICOS J-SAN</b>
      <small>{tagline}</small>
    </span>
  </a>
  <div class="tb-right">
    <a class="btn-line tb-desktop" href="/">← Inicio</a>
    <a class="btn-line tb-desktop" href="/nosotros/">Nosotros</a>
    <a class="btn-line tb-desktop" href="/contacto/">Contacto</a>
    <a
      class="btn-o"
      target="_blank"
      rel="noopener"
      href={waLink('Hola J-SAN, quiero consultar por una falla en mi caja automática')}
    >
      WhatsApp →
    </a>
    <!-- Hamburguesa: abre el menú global (mnav) definido en BaseLayout -->
    <button class="burger burger--topbar" id="burger" aria-label="Abrir menú" aria-controls="mnav">☰</button>
  </div>
</div>

<style>
  /* La hamburguesa vive oculta en desktop; visible ≤900px vía media query global */
  .burger--topbar{display:none}
  @media (max-width:900px){
    .tb-desktop{display:none}
    .burger--topbar{display:grid;place-items:center;width:44px;height:44px;background:transparent;border:2px solid var(--line-strong);color:var(--white);font-size:1.15rem;cursor:pointer}
  }
</style>
