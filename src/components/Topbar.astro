---
import { SITE } from '../data/site';

interface Props {
  tagline?: string;
}

const { tagline = 'Oficina: Urb. Monte Cristo, Calle 10, Miranda' } = Astro.props;
---

<div class="topbar" role="complementary" aria-label="Información de contacto rápido">
  <div class="wrap">
    <span class="tb-info"><b>{SITE.shortName}:</b> {tagline}</span>
    <span class="tb-phones">
      <a href={`tel:${SITE.phoneOficina1}`}>{SITE.phoneOficina1Display}</a>
      <span class="tb-sep" aria-hidden="true">·</span>
      <a href={`tel:${SITE.whatsapp}`}>{SITE.whatsappDisplay}</a>
    </span>
  </div>
</div>

<style>
  .topbar {
    background: var(--navy-deep);
    color: #c6d3ec;
    font-size: 0.82rem;
    border-bottom: 2px solid var(--gold);
  }

  .topbar .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 0;
    flex-wrap: wrap;
  }

  .tb-info b {
    color: #fff;
    font-weight: 600;
  }

  .topbar a {
    color: #c6d3ec;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .topbar a:hover {
    color: var(--gold-soft);
  }

  .tb-sep {
    margin: 0 0.35rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 960px) {
    .tb-info {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .topbar .wrap {
      justify-content: center;
    }
  }
</style>
