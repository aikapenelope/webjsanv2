---
import { SITE, NAV, waLink } from '../data/site';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
const waHeader = waLink('Hola J-SAN, quiero consultar por una falla en mi caja automática');
---

<header class="site">
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="Hidromáticos J-SAN — Inicio">
      <img
        src="/assets/logo-jsan.webp"
        alt="Escudo de Hidromáticos J-SAN, C.A."
        width="52"
        height="48"
        loading="eager"
      />
      <span>
        <span class="brand-name">HIDROMÁTICOS J-SAN</span>
        <span class="brand-sub">Líderes en Transmisiones · Est. 2013</span>
      </span>
    </a>

    <nav aria-label="Navegación principal">
      <ul class="nav-links">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                activePath === item.href && 'activo',
                item.badge && 'has-badge',
              ]}
            >
              {item.badge && <span class="nav-badge" aria-hidden="true">{item.badge}</span>}
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>

      <a class="btn btn-primary btn-sm btn-header-wa" href={waHeader} target="_blank" rel="noopener">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.5 14.1c-.2.7-1.3 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1.1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .6-.2 1.1Z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<!-- MENÚ MÓVIL (DRAWER) -->
<div class="mobile-nav" id="mobile-nav" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menú móvil">
  <div class="mobile-panel">
    <div class="mobile-head">
      <div class="mobile-brand">
        <img src="/assets/logo-jsan.webp" alt="Escudo J-SAN" width="42" height="39" />
        <div>
          <b>J-SAN</b>
          <small>Líderes en Transmisiones</small>
        </div>
      </div>
      <button class="cerrar-m" id="cerrar-m" aria-label="Cerrar menú">✕</button>
    </div>

    <div class="mobile-links">
      {NAV.map((item) => (
        <a class="m-link" href={item.href}>
          <span>
            {item.badge && <span style="margin-right: 0.35rem;">{item.badge}</span>}
            {item.label}
          </span>
          <span class="m-arr" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <div class="mobile-footer">
      <a class="btn btn-primary" href={waHeader} target="_blank" rel="noopener" style="width: 100%; justify-content: center;">
        <span>Consultar falla por WhatsApp</span>
      </a>
      <p class="m-foot-note">
        <b>Sede:</b> {SITE.sedeCorta}<br />
        <b>Teléfono:</b> {SITE.phoneOficina1Display}
      </p>
    </div>
  </div>
</div>

<style>
  header.site {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--sky-line);
    box-shadow: 0 1px 14px rgba(15, 42, 87, 0.06);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand img {
    height: 50px;
    width: auto;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.32rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--navy);
  }

  .brand-sub {
    display: block;
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--blue);
    text-transform: uppercase;
    margin-top: 0.18rem;
  }

  .nav-links {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    align-items: center;
  }

  .nav-links a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.93rem;
    color: var(--navy);
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0;
  }

  .nav-links a:hover,
  .nav-links a.activo {
    color: var(--blue);
  }

  .nav-links a.activo {
    border-bottom: 2px solid var(--gold);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--sky-line);
    background: #fff;
    border-radius: 12px;
    cursor: pointer;
    place-items: center;
    flex: none;
  }

  .menu-toggle svg {
    width: 22px;
    height: 22px;
    stroke: var(--navy);
    fill: none;
  }

  /* DRAWER MÓVIL */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(10, 30, 64, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    overflow: hidden;
  }

  .mobile-nav.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(340px, 88vw);
    height: 100%;
    background: #fff;
    padding: 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    transform: translateX(102%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -20px 0 50px rgba(10, 30, 64, 0.28);
    overflow-y: auto;
  }

  .mobile-nav.open .mobile-panel {
    transform: translateX(0);
  }

  .mobile-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--sky-line);
  }

  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .mobile-brand b {
    font-family: var(--font-display);
    font-size: 1.2rem;
    display: block;
    line-height: 1;
  }

  .mobile-brand small {
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cerrar-m {
    border: none;
    background: var(--sky);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.05rem;
    color: var(--navy);
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }

  .cerrar-m:hover {
    background: var(--sky-line);
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .mobile-panel a.m-link {
    padding: 0.85rem 0.3rem;
    text-decoration: none;
    font-weight: 700;
    color: var(--navy);
    border-bottom: 1px solid var(--sky-line);
    font-size: 1.02rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.15s ease;
  }

  .mobile-panel a.m-link:hover {
    color: var(--blue);
  }

  .m-arr {
    color: var(--gold);
    font-weight: 900;
  }

  .mobile-footer {
    margin-top: auto;
    padding-top: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .m-foot-note {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.4;
  }

  @media (max-width: 1040px) {
    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 560px) {
    .brand-sub {
      display: none;
    }
    .btn-header-wa span {
      display: none;
    }
    .btn-header-wa {
      padding: 0.5rem 0.75rem;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggleEl = document.getElementById('menu-toggle');
    const drawerEl = document.getElementById('mobile-nav');
    const closeBtnEl = document.getElementById('cerrar-m');

    if (!toggleEl || !drawerEl || !closeBtnEl) return;

    const toggle = toggleEl;
    const drawer = drawerEl;
    const closeBtn = closeBtnEl;

    function open() {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        close();
      }
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', close);
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
