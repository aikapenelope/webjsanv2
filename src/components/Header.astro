---
import { SITE, NAV } from '../data/site';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;
---

<header class="site" id="main-header">
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="HIDROMÁTICOS J.SAN, C.A. — Inicio">
      <img
        src="/assets/logo-jsan.webp"
        alt="Escudo oficial de HIDROMÁTICOS J.SAN, C.A."
        width="54"
        height="50"
        loading="eager"
      />
      <span class="brand-text">
        <span class="brand-name">HIDROMÁTICOS J.SAN</span>
        <span class="brand-sub">
          <span>Líderes en Transmisiones</span>
          <span class="brand-rif-badge">RIF: {SITE.rifSimple}</span>
        </span>
      </span>
    </a>

    <nav aria-label="Navegación principal">
      <ul class="nav-links">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                activePath === item.href && 'activo',
                item.badge && 'has-badge',
              ]}
            >
              {item.badge && <span class="nav-badge" aria-hidden="true">{item.badge}</span>}
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <!-- BOTÓN MENÚ MÓVIL (ACCESIBLE Y TÁCTIL) -->
      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">Menú</span>
        <svg viewBox="0 0 24 24" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- MENÚ MÓVIL (DRAWER LATERAL) -->
<div class="mobile-nav" id="mobile-nav" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menú móvil de navegación">
  <div class="mobile-panel">
    <div class="mobile-head">
      <div class="mobile-brand">
        <img src="/assets/logo-jsan.webp" alt="Escudo J-SAN" width="46" height="42" />
        <div>
          <b>HIDROMÁTICOS J.SAN</b>
          <span class="m-rif">RIF: {SITE.rif}</span>
        </div>
      </div>
      <button class="cerrar-m" id="cerrar-m" aria-label="Cerrar menú">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="mobile-links">
      {NAV.map((item) => (
        <a class="m-link" href={item.href}>
          <span>
            {item.badge && <span class="m-link-badge">{item.badge}</span>}
            {item.label}
          </span>
          <span class="m-arr" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <div class="mobile-footer">
      <div class="m-company-info">
        <p class="m-name"><strong>{SITE.name}</strong></p>
        <p class="m-rif-full">RIF: {SITE.rif} · Est. {SITE.fundacion}</p>
        <p class="m-loc">{SITE.sedeCorta} — Miranda, Caracas</p>
        <p class="m-phone">
          <a href={`tel:${SITE.phoneOficina1}`}>{SITE.phoneOficina1Display}</a>
          <span class="m-phone-sep" aria-hidden="true">·</span>
          <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">{SITE.whatsappDisplay}</a>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  header.site {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--sky-line);
    box-shadow: 0 2px 14px rgba(15, 42, 87, 0.05);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-sub {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--blue);
    text-transform: uppercase;
    margin-top: 0.2rem;
    min-width: 0;
    white-space: nowrap;
  }

  .brand-rif-badge {
    color: #8f6f12;
    background: rgba(201, 162, 39, 0.18);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    align-items: center;
  }

  .nav-links li {
    display: inline-flex;
  }

  .nav-links a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--navy);
    transition: color 0.15s ease, background 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.42rem 0.7rem;
    border-radius: 999px;
    border-bottom: none;
  }

  .nav-links a:hover {
    color: var(--blue);
    background: var(--blue-soft);
  }

  .nav-links a.activo {
    color: var(--blue);
    background: var(--blue-soft);
    box-shadow: inset 0 -2px 0 var(--gold);
  }

  .nav-badge {
    font-size: 0.62rem;
    font-weight: 700;
    color: #8f6f12;
    background: rgba(201, 162, 39, 0.18);
    padding: 0.12rem 0.4rem;
    border-radius: 999px;
    line-height: 1.2;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--sky-line);
    background: var(--sky);
    border-radius: 12px;
    cursor: pointer;
    place-items: center;
    flex: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .menu-toggle:hover {
    background: var(--sky-line);
    border-color: var(--blue);
  }

  .menu-toggle svg {
    width: 24px;
    height: 24px;
    stroke: var(--navy);
    fill: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* DRAWER MÓVIL */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(10, 30, 64, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    overflow: hidden;
  }

  .mobile-nav.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(340px, 86vw);
    height: 100%;
    background: #ffffff;
    padding: 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    transform: translateX(102%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -20px 0 50px rgba(10, 30, 64, 0.28);
    overflow-y: auto;
  }

  .mobile-nav.open .mobile-panel {
    transform: translateX(0);
  }

  .mobile-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--sky-line);
  }

  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .mobile-brand b {
    font-family: var(--font-display);
    font-size: 1.18rem;
    display: block;
    line-height: 1.1;
    color: var(--navy);
  }

  .m-rif {
    font-size: 0.72rem;
    color: var(--blue);
    font-weight: 700;
  }

  .cerrar-m {
    border: none;
    background: var(--sky);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    color: var(--navy);
    display: grid;
    place-items: center;
    transition: background 0.15s ease;
  }

  .cerrar-m:hover {
    background: var(--sky-line);
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
  }

  .mobile-panel a.m-link {
    padding: 0.9rem 0.4rem;
    text-decoration: none;
    font-weight: 700;
    color: var(--navy);
    border-bottom: 1px solid var(--sky-line);
    font-size: 1.05rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.15s ease, padding-left 0.15s ease;
  }

  .mobile-panel a.m-link:hover {
    color: var(--blue);
    padding-left: 0.6rem;
  }

  .m-link-badge {
    margin-right: 0.35rem;
  }

  .m-arr {
    color: var(--gold);
    font-weight: 900;
    font-size: 1.2rem;
  }

  .mobile-footer {
    margin-top: auto;
    padding-top: 1.4rem;
    border-top: 1px solid var(--sky-line);
  }

  .m-company-info {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .m-name strong {
    color: var(--navy);
    font-size: 0.86rem;
  }

  .m-rif-full {
    color: var(--blue);
    font-weight: 600;
  }

  .m-phone a {
    color: var(--blue);
    font-weight: 700;
  }

  .m-phone-sep {
    color: var(--sky-line);
    margin: 0 0.15rem;
  }

  @media (max-width: 1240px) {
    .nav-links {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 480px) {
    .nav {
      padding: 0.5rem 0;
    }
    .brand img {
      height: 40px;
    }
    .brand-name {
      font-size: 1.12rem;
    }
    .brand-sub {
      font-size: 0.6rem;
    }
    .brand-sub > span:first-child {
      display: none;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggleEl = document.getElementById('menu-toggle');
    const drawerEl = document.getElementById('mobile-nav');
    const closeBtnEl = document.getElementById('cerrar-m');

    if (!toggleEl || !drawerEl || !closeBtnEl) return;

    const toggle = toggleEl;
    const drawer = drawerEl;
    const closeBtn = closeBtnEl;

    function open() {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        close();
      }
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', close);
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
