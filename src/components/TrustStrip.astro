---
const STRIP_ITEMS = [
  'Más de 12 años de experiencia',
  'Líderes en transmisiones automáticas',
  'Repuestos importados originales',
  'Diagnóstico computarizado previo',
  'Presupuesto claro antes de trabajar',
  'Garantía escrita por 6 meses',
  'Taller especialista en Caracas',
];
---

<div class="strip" role="region" aria-label="Garantías y credenciales de servicio">
  <div class="strip-track">
    <div class="strip-group">
      {STRIP_ITEMS.map((item) => (
        <span class="strip-item">
          <span class="strip-mark" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 1.8 14.6 9l7.4 1.4-5.5 5.1 1.4 7.3L12 19.1l-5.9 3.7 1.4-7.3L2 10.4 9.4 9 12 1.8Z"/>
            </svg>
          </span>
          <span>{item}</span>
        </span>
      ))}
    </div>
    <div class="strip-group" aria-hidden="true">
      {STRIP_ITEMS.map((item) => (
        <span class="strip-item">
          <span class="strip-mark" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 1.8 14.6 9l7.4 1.4-5.5 5.1 1.4 7.3L12 19.1l-5.9 3.7 1.4-7.3L2 10.4 9.4 9 12 1.8Z"/>
            </svg>
          </span>
          <span>{item}</span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .strip {
    background: var(--navy);
    color: #ffffff;
    border-top: 1px solid rgba(201, 162, 39, 0.4);
    border-bottom: 1px solid var(--navy-deep);
    overflow: hidden;
    padding: 0.9rem 0;
    user-select: none;
    position: relative;
    mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 2%, #000 98%, transparent);
  }

  .strip-track {
    display: flex;
    width: max-content;
    animation: mq 36s linear infinite;
  }

  .strip:hover .strip-track {
    animation-play-state: paused;
  }

  .strip-group {
    display: flex;
    align-items: center;
    gap: 2.6rem;
    padding-right: 2.6rem;
    flex-shrink: 0;
  }

  .strip-item {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    color: #e7eefb;
  }

  .strip-mark {
    color: var(--gold);
    display: inline-flex;
    flex: none;
  }

  @media (max-width: 600px) {
    .strip {
      padding: 0.7rem 0;
    }
    .strip-group {
      gap: 1.7rem;
      padding-right: 1.7rem;
    }
    .strip-item {
      font-size: 0.95rem;
    }
  }
</style>