---
const STRIP_ITEMS = [
  'Más de 12 años de experiencia',
  'Líderes en transmisiones automáticas',
  'Repuestos importados originales',
  'Diagnóstico computarizado previo',
  'Presupuesto claro antes de trabajar',
  'Garantía escrita por 6 meses',
  'Taller especialista en Caracas',
];
---

<div class="strip" role="region" aria-label="Garantías y credenciales de servicio">
  <div class="wrap strip-inner">
    {STRIP_ITEMS.map((item, idx) => (
      <span class="strip-item">
        {item}
        {idx < STRIP_ITEMS.length - 1 && <span class="strip-dot" aria-hidden="true"></span>}
      </span>
    ))}
  </div>
</div>

<style>
  .strip {
    background: var(--navy);
    color: #ffffff;
    border-bottom: 1px solid var(--navy-deep);
    padding: 0.85rem 0;
  }

  .strip-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    column-gap: 1.6rem;
    row-gap: 0.4rem;
  }

  .strip-item {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #dfe8f8;
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    white-space: nowrap;
  }

  .strip-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold);
    flex: none;
    opacity: 0.85;
  }

  @media (max-width: 760px) {
    .strip-inner {
      justify-content: flex-start;
      column-gap: 1.2rem;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.2rem;
      scrollbar-width: none;
    }
    .strip-inner::-webkit-scrollbar {
      display: none;
    }
    .strip-item {
      gap: 1.2rem;
      font-size: 0.72rem;
    }
  }
</style>