---
const STRIP_ITEMS = [
  'Más de 12 años de experiencia',
  'Líderes en transmisiones automáticas',
  'Repuestos importados originales',
  'Diagnóstico computarizado previo',
  'Presupuesto claro antes de trabajar',
  'Garantía escrita por 6 meses',
  'Taller especialista en Caracas',
];
---

<div class="strip-container" role="region" aria-label="Garantías y credenciales de servicio">
  <div class="strip-track">
    {[0, 1].map(() => (
      <div class="strip-group" aria-hidden="true">
        {STRIP_ITEMS.map((item) => (
          <div class="strip-item">
            <span class="strip-star" aria-hidden="true">★</span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .strip-container {
    background: var(--navy);
    color: #ffffff;
    border-top: 3px solid var(--gold);
    border-bottom: 1px solid var(--navy-deep);
    overflow: hidden;
    padding: 0.95rem 0;
    user-select: none;
    position: relative;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .strip-track {
    display: flex;
    width: max-content;
    animation: stripMarquee 32s linear infinite;
  }

  .strip-container:hover .strip-track {
    animation-play-state: paused;
  }

  .strip-group {
    display: flex;
    align-items: center;
    gap: 2.8rem;
    padding-right: 2.8rem;
    flex-shrink: 0;
  }

  .strip-item {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
    color: #f0f4fc;
  }

  .strip-star {
    color: var(--gold);
    font-size: 0.95rem;
    filter: drop-shadow(0 0 4px rgba(201, 162, 39, 0.4));
  }

  @keyframes stripMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 600px) {
    .strip-container {
      padding: 0.75rem 0;
    }
    .strip-item {
      font-size: 0.95rem;
    }
    .strip-group {
      gap: 1.8rem;
      padding-right: 1.8rem;
    }
  }
</style>
