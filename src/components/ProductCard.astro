---
import type { Producto } from '../data/productos';
import { waLink } from '../data/site';

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;

const waProductMsg = waLink(
  `Hola J-SAN, vi en la web la transmisión "${producto.nombre}" (${producto.tipo} - ${producto.estado}). Quiero consultar disponibilidad, precio y compatibilidad con mi vehículo:`
);
---

<article
  class="prod-card"
  data-marca={producto.marcaId}
  data-estado={producto.estadoClase}
>
  <div class="prod-img-wrap">
    <img
      src={producto.imagen}
      alt={producto.nombre}
      loading="lazy"
      width="400"
      height="300"
    />
    <span class:list={['badge-estado', `be-${producto.estadoClase}`]}>
      {producto.estado}
    </span>
    <span class:list={['badge-stock', producto.stock === 'Pocas unidades' && 'bajo']}>
      {producto.stock}
    </span>
  </div>

  <div class="prod-body">
    <span class="prod-marca">{producto.marca} · {producto.tipo}</span>
    <h3>{producto.nombre}</h3>

    <ul class="prod-specs">
      {producto.specs.map((spec) => (
        <li>{spec}</li>
      ))}
    </ul>

    <div class="prod-foot">
      <div class="prod-price-box">
        <small>Disponibilidad</small>
        <b>En Caracas</b>
      </div>
      <a class="btn btn-primary btn-sm btn-cotizar" href={waProductMsg} target="_blank" rel="noopener">
        <span>Cotizar por WhatsApp →</span>
      </a>
    </div>
  </div>
</article>

<style>
  .prod-card {
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(15, 42, 87, 0.05);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .prod-card:hover {
    box-shadow: 0 18px 40px rgba(15, 42, 87, 0.12);
    transform: translateY(-4px);
  }

  .prod-img-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    background: linear-gradient(160deg, var(--sky), #dfe9f7);
    overflow: hidden;
  }

  .prod-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .prod-card:hover .prod-img-wrap img {
    transform: scale(1.05);
  }

  .badge-estado {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
  }

  .be-usada {
    color: var(--gold);
    border: 1.5px solid var(--gold);
  }

  .be-recon {
    color: var(--blue);
    border: 1.5px solid var(--blue);
  }

  .be-nueva {
    color: var(--green);
    border: 1.5px solid var(--green);
  }

  .badge-stock {
    position: absolute;
    bottom: 0.8rem;
    right: 0.8rem;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--navy);
    color: #ffffff;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .badge-stock.bajo {
    background: var(--gold);
    color: var(--navy-deep);
  }

  .prod-body {
    padding: 1.4rem 1.3rem 1.3rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .prod-marca {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.35rem;
    display: block;
  }

  .prod-body h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.45rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--navy);
    margin-bottom: 0.8rem;
  }

  .prod-specs {
    list-style: none;
    font-size: 0.86rem;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.4rem;
    flex: 1;
  }

  .prod-specs li {
    display: flex;
    align-items: baseline;
    line-height: 1.4;
  }

  .prod-specs li::before {
    content: "·";
    color: var(--gold);
    font-weight: 900;
    font-size: 1.2rem;
    margin-right: 0.4rem;
    line-height: 0;
  }

  .prod-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    border-top: 1px solid var(--sky-line);
    padding-top: 1rem;
  }

  .prod-price-box small {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .prod-price-box b {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1;
  }

  .btn-cotizar {
    font-size: 0.82rem;
    padding: 0.48rem 0.95rem;
    white-space: nowrap;
  }
</style>
